 !-----------------------------------------------------------------------

+   subroutine cam_set_constituent_minima()
+      use cam_constituents,          only: const_set_qmin, const_get_index
+      use runtime_obj,               only: wv_stdname
+      use phys_comp,                 only: phys_suite_name
+      use ccpp_kinds,                only: kind_phys
+      use ccpp_constituent_prop_mod, only: ccpp_constituent_prop_ptr_t
+      use cam_ccpp_cap,              only: cam_model_const_properties
+
+      type(ccpp_constituent_prop_ptr_t), pointer :: const_props(:)
+      integer :: const_idx
+
+      const_props => cam_model_const_properties()
+
+      ! CCPP initialization can replace constituent-property objects, and
+      ! the property array is not ordered with all advected entries first.
+      ! Initialize the complete, final array deterministically.
+      do const_idx = 1, size(const_props)
+         call const_set_qmin(const_idx, 0._kind_phys)
+      end do
+
+      if (phys_suite_name /= 'held_suarez_1994') then
+         call const_get_index(wv_stdname, const_idx)
+         call const_set_qmin(const_idx, 1.E-12_kind_phys)
+      end if
+   end subroutine cam_set_constituent_minima
+
+!-----------------------------------------------------------------------
+
 end module cam_comp
