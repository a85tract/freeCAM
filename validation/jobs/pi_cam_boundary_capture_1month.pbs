#!/bin/bash
# Submit with: qsub -A <account> validation/jobs/pi_cam_boundary_capture_1month.pbs
#PBS -N pycam-x2a-1mon
#PBS -q cpudev
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /glade/work/ruitong/freeCAM/logs/
#PBS -V

set -euo pipefail

repo=/glade/work/ruitong/freeCAM
case_root=/glade/work/ruitong/CESM_cases/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-atm.pycesm-ref.50step
oracle_run=/glade/derecho/scratch/ruitong/pyCESM/PI-atm/oracle-1month/run
output_root=/glade/derecho/scratch/ruitong/pyCAM/PI-cam/nonpic-boundary-capture-1month
run_dir=${output_root}/run
capture_root=${output_root}/boundary
capture_prefix=${capture_root}/raw/pi_cam
replay_root=${capture_root}/replay
executable=${repo}/build/pi_cam/pi_cam_capture.exe

cleanup_raw() {
  if [[ -d "${capture_root}/raw" ]]; then
    find "${capture_root}/raw" -type f -print0 \
      | xargs -0 -r -n 512 -P 32 rm -f
    find "${capture_root}/raw" -depth -type d -empty -delete
  fi
}

# A capture can be interrupted after the verified replay bundles are safe but
# while Lustre is deleting the per-step files.  This mode resumes only that
# parallel cleanup without touching the replay or model output.
if [[ "${CLEANUP_ONLY:-0}" == 1 ]]; then
  cleanup_raw
  exit 0
fi

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
rm -rf "${capture_root}/raw" "${replay_root}" "${run_dir}"
mkdir -p "${capture_root}/raw" "${run_dir}"
rsync -a \
  --exclude 'f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-atm.pycesm-ref.50step.*' \
  --exclude '*.log.*' --exclude 'cesm-oracle-one-month.*' \
  --exclude 'rpointer.*' --exclude 'timing/' \
  "${oracle_run}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"

export PYCAM_BOUNDARY_CAPTURE=${capture_prefix}
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks

cd "${run_dir}"
mpiexec --label -n 512 \
  "${executable}" > cesm.log.pi-cam-boundary-capture-1month 2>&1

cd "${repo}"
PYTHONPATH=${repo}/src ${repo}/.venv/bin/python \
  tools/convert_pi_cam_boundary.py \
  --capture-prefix "${capture_prefix}" \
  --output "${replay_root}" \
  --config configs/pi_cam_icesm131_1month.yaml \
  --summary validation/pi_cam_boundary_capture_1month.json

PYTHONPATH=${repo}/src ${repo}/.venv/bin/python \
  tools/verify_pi_cam.py \
  --reference "${oracle_run}" \
  --candidate "${run_dir}" \
  --output validation/pi_cam_nonpic_capture_vs_oracle_1month_bfb.json

# The replay directory contains the same numerical payload in 512 rank bundles.
# Remove the per-step raw files only after conversion and BFB verification pass.
cleanup_raw
