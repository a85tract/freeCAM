#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_function_capture_50step.pbs
#PBS -N pycam-function-capture
#PBS -q develop
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o logs/
#PBS -V

# Evidence for the physics-function captures, in four parts:
#   A  the capture executable with capture ON (steps 1-2) runs the 50-step
#      case and must stay bit-for-bit with the oracle -- the recompiled
#      physpkg.o / macrop_driver.o did not change the numerics;
#   B  the same executable with capture OFF must also be bit-for-bit -- the
#      hook is inert when unset;
#   C  the streams are converted into per-function replay bundles (scratch)
#      with summaries under validation/;
#   D  rank 0 of an initialized freeCAM model snapshots the module state each
#      function reads, re-read after one step to confirm it is init-time.

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_REFERENCE_CASE}
oracle_run=${FREECAM_REFERENCE_RUN}
root=${FREECAM_SCRATCH}/pyCAM/PI-cam/function-capture-${PBS_JOBID}
executable=${repo}/build/pi_cam_function_capture/pi_cam_function_capture.exe
boundary=${FREECAM_SCRATCH}/pyCAM/PI-cam/nonpic-boundary-capture-50step/boundary/replay
manifest=${repo}/build/pi_cam_promoted/native_cam_manifest.json

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

prepare_run() {
  rm -rf "$1"; mkdir -p "$1"
  rsync -a \
    --exclude 'f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step.*' \
    --exclude '*.log.*' --exclude 'rpointer.*' --exclude 'timing/' \
    "${oracle_run}/" "$1/"
  mkdir -p "$1/timing/checkpoints"
}

# A: capture on
mkdir -p "${root}/raw"
prepare_run "${root}/run-on"
cd "${root}/run-on"
PYCAM_FUNCTION_CAPTURE="${root}/raw/function" PYCAM_FUNCTION_CAPTURE_STEPS=1,2 \
  mpiexec --label -n 512 "${executable}" > cesm.log.function-capture 2>&1
cd "${repo}"
PYTHONPATH=${repo}/src "${python}" tools/verify_pi_cam.py \
  --reference "${oracle_run}" --candidate "${root}/run-on" \
  --output validation/pi_cam_function_capture_vs_oracle_50step_bfb.json

# B: capture off
prepare_run "${root}/run-off"
cd "${root}/run-off"
env -u PYCAM_FUNCTION_CAPTURE -u PYCAM_FUNCTION_CAPTURE_STEPS \
  mpiexec --label -n 512 "${executable}" > cesm.log.function-capture-off 2>&1
cd "${repo}"
PYTHONPATH=${repo}/src "${python}" tools/verify_pi_cam.py \
  --reference "${oracle_run}" --candidate "${root}/run-off" \
  --output validation/pi_cam_function_capture_disabled_vs_oracle_50step_bfb.json

# C: convert
PYTHONPATH=${repo}/src "${python}" tools/convert_pi_cam_function_capture.py \
  --capture-prefix "${root}/raw/function" \
  --output-dir "${root}/bundles" \
  --summary-dir validation \
  --executable-sha256 "$(sha256sum "${executable}" | cut -d' ' -f1)"

# D: module-state snapshot from an initialized freeCAM model
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=${FREECAM_LD_PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
prepare_run "${root}/run-snapshot"
mpiexec --label -n 512 "${python}" tools/snapshot_pi_cam_module_state.py \
  --config configs/pi_cam_icesm131_replay.yaml \
  --boundary "${boundary}" \
  --run-dir "${root}/run-snapshot" \
  --native-manifest "${manifest}" \
  --function dadadj --function mmacro_pcond \
  --output-dir validation \
  > "${root}/run-snapshot/snapshot.log" 2>&1

echo "capture bundles: ${root}/bundles"
ls -la "${root}/bundles"
