#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_promoted_statepool_build.pbs
#PBS -N freecam-statepool-adapters
#PBS -q develop
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o logs/
#PBS -V

set -euxo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"
trap 'status=$?; echo "PI-CAM device build exit status: ${status}"' EXIT

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_STATE_CASE}
# Reuse the machine code from the admitted BFB oracle build.  The
# python-state case supplies replacement .mod files and control shells only;
# using its rebuilt libatm.a would change the numerical object boundary.
numerical_build=${FREECAM_SCRATCH}/pyCAM/PI-cam/${FREECAM_REFERENCE_CASE_NAME}/bld
# Both are overridable so a rebuild can be checked against the image in use
# instead of replacing it:
#   FREECAM_IMAGE_ROOT=$SCRATCH/verify-image validation/jobs/submit.sh ...
output_root=${FREECAM_IMAGE_ROOT:-${repo}/build/pi_cam_promoted}
prepared_source=${FREECAM_PREPARED_SOURCE:-${repo}/build/iCESM1.3.1_PI_cam_only}

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
export PYTHONPATH=${repo}/src

cd "${repo}"
mkdir -p "${output_root}"
# Re-prepare the patched source tree first.  It is a build product, and a
# stale one silently drops a support module or a control patch added since it
# was last written -- which is exactly how 7255599 failed.
rm -rf "${prepared_source}"
"${python}" tools/prepare_pi_cam_source.py --output "${prepared_source}"

"${python}" tools/generate_pi_cam_python_state_source.py \
  --source-root "${prepared_source}" \
  --output-dir "${case_root}/SourceMods/src.cam"
"${python}" tools/build_pi_cam_promoted_kernels.py \
  --output native/pi_cam/direct_kernels_promoted.yaml

"${python}" tools/build_pi_cam_devices.py \
  --case "${case_root}" \
  --source-root "${prepared_source}" \
  --zero-copy-state \
  --numerical-build "${numerical_build}" \
  --direct-kernels "${repo}/native/pi_cam/direct_kernels_promoted.yaml" \
  --output "${output_root}/libfreecam_pi_cam.so" \
  --capture-executable "${output_root}/pi_cam_capture.exe" \
  --manifest "${output_root}/native_cam_manifest.json" \
  > "${output_root}/build-manifest.stdout.json"

"${python}" - "${output_root}" <<'PY'
import json
import sys
from pathlib import Path

manifest = Path(sys.argv[1]) / "native_cam_manifest.json"
payload = json.loads(manifest.read_text())
names = tuple(item["name"] for item in payload["direct_kernels"]["kernels"])
assert len(names) == 71, names
assert "dadadj" in names
assert "cloud_fraction_fice" in names
assert "zm_conv_evap" in names
# the macrophysics driver's routines, reached from Python in its place
assert "mmacro_pcond" in names
assert "macrop_detrain_partition" in names
assert "wtrc_add_rates" in names
# the radiation driver's routines, reached from Python in its place
assert "rad_gather_day_night" in names
assert "rad_snow_blend_sw" in names
assert "rad_theta_heating" in names
assert "rad_inp" in names
# the microphysics driver's and the stage glue's routines
assert "micro_liquid_size" in names
assert "micro_history_tendencies" in names
assert "mm_precip_average" in names
print({"manifest": str(manifest), "direct_kernels": names})
PY
