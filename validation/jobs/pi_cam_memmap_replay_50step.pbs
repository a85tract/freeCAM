#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_memmap_replay_50step.pbs
#PBS -N freecam-mmap-50
#PBS -q develop
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o logs/
#PBS -V

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_REFERENCE_CASE}
reference=${FREECAM_REFERENCE_RUN}
boundary=${FREECAM_SCRATCH}/freeCAM/PI-cam/stream-boundary-50step/boundary/replay-memmap-v1
run_dir=${FREECAM_SCRATCH}/freeCAM/PI-cam/memmap-replay-50step-${PBS_JOBID}/run

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=${FREECAM_LD_PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks

mkdir -p "${run_dir}/timing/checkpoints"
rsync -a \
  --exclude '*.cam.*.nc' --exclude '*.log*' --exclude 'rpointer.*' \
  --exclude 'timing/' "${reference}/" "${run_dir}/"

cd "${repo}"
mpiexec --label -n 512 "${python}" -m freecam.pi_cam.cli \
  --config configs/pi_cam_icesm131_replay.yaml \
  --boundary "${boundary}" \
  --run-dir "${run_dir}" \
  --steps 50 \
  --summary validation/pi_cam_memmap_replay_50step.json \
  > "${run_dir}/freecam.log" 2>&1

"${python}" tools/verify_pi_cam.py \
  --reference "${reference}" \
  --candidate "${run_dir}" \
  --output validation/pi_cam_memmap_replay_vs_oracle_50step_bfb.json
