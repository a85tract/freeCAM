#!/bin/bash
#PBS -N freecam-mmap-50
#PBS -q develop
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o /glade/work/ruitong/freeCAM/logs/
#PBS -V

set -euo pipefail

repo=/glade/work/${USER}/freeCAM
python=${repo}/.venv/bin/python
case_root=/glade/work/${USER}/CESM_cases/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step
reference=/glade/derecho/scratch/${USER}/pyCAM/PI-cam/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step/run
boundary=/glade/derecho/scratch/${USER}/freeCAM/PI-cam/stream-boundary-50step/boundary/replay-memmap-v1
run_dir=/glade/derecho/scratch/${USER}/freeCAM/PI-cam/memmap-replay-50step-${PBS_JOBID}/run

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=/glade/u/apps/common/23.04/spack/opt/spack/intel-oneapi-compilers/2023.0.0/compiler/2023.0.0/linux/compiler/lib/intel64_lin/libimf.so${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks

mkdir -p "${run_dir}/timing/checkpoints"
rsync -a \
  --exclude '*.cam.*.nc' --exclude '*.log*' --exclude 'rpointer.*' \
  --exclude 'timing/' "${reference}/" "${run_dir}/"

cd "${repo}"
mpiexec --label -n 512 "${python}" -m freecam.pi_cam.cli \
  --config configs/pi_cam_icesm131_replay.yaml \
  --boundary "${boundary}" \
  --run-dir "${run_dir}" \
  --steps 50 \
  --summary validation/pi_cam_memmap_replay_50step.json \
  > "${run_dir}/freecam.log" 2>&1

"${python}" tools/verify_pi_cam.py \
  --reference "${reference}" \
  --candidate "${run_dir}" \
  --output validation/pi_cam_memmap_replay_vs_oracle_50step_bfb.json
