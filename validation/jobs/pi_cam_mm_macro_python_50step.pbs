#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_mm_macro_python_50step.pbs
#PBS -N pycam-mm-macro-py-50
#PBS -q develop
# Preserve the validated rank placement: 512 MPI ranks on four nodes while
# charging the cpudev maximum of 256 physical CPUs.
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o logs/
#PBS -V

# Gate M-2 of the cloud macro/microphysics transliteration: Gate M-1's
# stage with the Macrophysics walk composed into it in macrop_driver_tend's
# place -- its ptend, det_s and det_ice taken over exactly as the split
# stage's post-leaf took them -- and microp_driver_tend still called whole.
# It differs from Gate M-1's run by exactly the sub-walk; bfb: true is the
# only acceptable result.

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_STATE_CASE}
oracle_run=${FREECAM_REFERENCE_RUN}
mode=${PYCAM_EXECUTION_MODE:-fine_grained}
run_dir=${FREECAM_SCRATCH}/pyCAM/PI-cam/mm-macro-python-${mode}-${PBS_JOBID}/run
boundary=${FREECAM_SCRATCH}/pyCAM/PI-cam/nonpic-boundary-capture-50step/boundary/replay
manifest=${PYCAM_NATIVE_MANIFEST:-${repo}/build/pi_cam_promoted/native_cam_manifest.json}
summary=${PYCAM_SUMMARY:-validation/pi_cam_mm_macro_python_50step.json}
bfb_output=${PYCAM_BFB_OUTPUT:-validation/pi_cam_mm_macro_python_vs_oracle_50step_bfb.json}
# Per-rank timing of every handle entry, kernel and trace hash by name.
export FREECAM_MM_PROFILE=${run_dir}/mm_profile
export FREECAM_MACRO_PROFILE=${run_dir}/macro_profile

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=${FREECAM_LD_PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

mkdir -p "${run_dir}"
rsync -a \
  --exclude 'f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step.*' \
  --exclude '*.log.*' --exclude 'rpointer.*' --exclude 'timing/' \
  "${oracle_run}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"

cd "${repo}"
mpiexec --label -n 512 "${python}" -m freecam.pi_cam.cli \
  --config configs/pi_cam_icesm131_replay.yaml \
  --native-manifest "${manifest}" \
  --boundary "${boundary}" \
  --run-dir "${run_dir}" \
  --execution-mode "${mode}" \
  --cloud-macro-micro-python \
  --cloud-macro-micro-whole-micro \
  --steps 50 \
  --summary "${summary}" \
  > "${run_dir}/pi_cam_python.log" 2>&1 || echo "model run exited $? (comparing the output anyway)"

status=0
"${python}" tools/verify_pi_cam.py \
  --reference "${oracle_run}" \
  --candidate "${run_dir}" \
  --output "${bfb_output}" || status=$?

echo "--- where the Python stage's time went (mean per rank) ---"
"${python}" tools/summarize_stage_profile.py "${run_dir}/mm_profile" --prefix mm --top 25 \
  --output "${run_dir}/mm_profile_summary.json" || true
"${python}" tools/summarize_stage_profile.py "${run_dir}/macro_profile" --prefix macro --top 15 \
  --output "${run_dir}/macro_profile_summary.json" || true
exit "${status}"
