#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_workflow_builder_50step.pbs
#PBS -N freecam-builder-50
#PBS -q develop
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=110GB
#PBS -l walltime=00:50:00
#PBS -j oe
#PBS -o logs/
#PBS -V

# The Workflow Builder's acceptance on the model: three exact-online 50-step
# runs in one allocation, each compared byte for byte with the oracle.
#
#   cli          the existing gate as is (the MPI command line), for the time to compare with
#   default      the default workflow generated by the builder, run through freecam.Driver
#                -- the path the page runs -- so nothing the builder does changes the answer
#   noop-python  the default plus a Python process that does nothing, so a process the
#                page inserts is reached every step and the answer still matches
#
# `node` must be on PATH for the generator bundle (it is inherited with -V).

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_REFERENCE_CASE}
cam_reference=${FREECAM_REFERENCE_RUN}
cesm_reference=${FREECAM_SCRATCH}/pyCESM/PI-atm/oracle-50step-run1/run
oracle=${FREECAM_SCRATCH}/pyCAM/PI-cam/nonpic-boundary-capture-50step/boundary/replay
library=${FREECAM_CESM_PROVIDER_LIBRARY:-${repo}/build/cesm/pi_atm/production-components/libpycesm_external_atm.so}
root=${FREECAM_SCRATCH}/pyCAM/PI-cam/workflow-builder-50step-${PBS_JOBID}
record=validation/pi_cam_workflow_builder_50step.json

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=${FREECAM_LD_PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'
export FREECAM_CESM_PROVIDER_LIBRARY=${library}

command -v node >/dev/null || { echo "node is not on PATH; the generator bundle needs it" >&2; exit 2; }

cd "${repo}"
mkdir -p "${root}/cli/cam-run" "${root}/cli/cesm-provider-run"

echo "=== cli: the existing gate ($(date)) ==="
cam_run=${root}/cli/cam-run
cesm_run=${root}/cli/cesm-provider-run
rsync -a --exclude '*.nc' --exclude '*.bin' --exclude '*.log*' \
  --exclude 'rpointer.*' --exclude 'timing/' "${cam_reference}/" "${cam_run}/"
rsync -a --exclude '*.nc' --exclude '*.bin' --exclude '*.log*' \
  --exclude 'rpointer.*' --exclude 'timing/' "${cesm_reference}/" "${cesm_run}/"
cp "${cam_reference}/SEMapping.nc" "${cam_run}/"
cp "${cesm_reference}/SEMapping.nc" "${cesm_run}/"
mkdir -p "${cam_run}/timing/checkpoints" "${cesm_run}/timing/checkpoints"
"${python}" - <<PY
from pathlib import Path
import cloudpickle
from freecam import CESMOnlineBoundaryProvider
provider = CESMOnlineBoundaryProvider(library=Path("${library}"), run_dir=Path("${cesm_run}"), oracle=Path("${oracle}"))
Path("${cam_run}/.exact-cesm-provider.pkl").write_bytes(cloudpickle.dumps(provider, protocol=5))
PY
mpiexec --label -n 512 "${python}" -m freecam.pi_cam.cli \
  --config configs/pi_cam_icesm131_exact_online_50step.yaml \
  --boundary-provider "${cam_run}/.exact-cesm-provider.pkl" \
  --run-dir "${cam_run}" \
  --steps 50 \
  --summary "${root}/cli/summary.json" \
  > "${cam_run}/freecam.log" 2>&1
"${python}" tools/verify_pi_cam.py --reference "${cam_reference}" --candidate "${cam_run}" --output "${root}/cli/bfb.json"
"${python}" - <<PY
import json
from pathlib import Path
summary = json.load(open("${root}/cli/summary.json")); bfb = json.load(open("${root}/cli/bfb.json"))
path = Path("${record}")
record = json.loads(path.read_text()) if path.is_file() else {"schema_version": 1, "what": "The Workflow Builder's generated configuration run through freecam.Driver -- the path the page runs -- on the exact-online 50-step case, compared byte for byte with the oracle.", "variants": {}}
record["variants"]["cli"] = {"pbs_job_id": "${PBS_JOBID}", "steps": 50, "advance_seconds": summary["timing"]["advance_seconds"], "bfb": bfb, "how": "python -m freecam.pi_cam.cli under mpiexec, as the existing gate"}
path.write_text(json.dumps(record, indent=2) + "\n")
print("cli: advance", summary["timing"]["advance_seconds"], "bfb", bfb["bfb"])
PY

for variant in default noop-python; do
  echo "=== ${variant}: generated configuration through freecam.Driver ($(date)) ==="
  "${python}" tools/run_workflow_builder_gate.py \
    --variant "${variant}" --steps 50 --root "${root}" \
    --config configs/pi_cam_icesm131_exact_online_50step.yaml \
    --reference "${cam_reference}" --seed-run "${cesm_reference}" --boundary-oracle "${oracle}" \
    --record "${record}" --pbs-job-id "${PBS_JOBID}" || echo "${variant}: not bit-for-bit or failed (recorded)"
done
echo "root: ${root}"
