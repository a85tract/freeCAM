#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_macro_tend_50step.pbs
#PBS -N pycam-macro-tend-50
#PBS -q develop
# Preserve the validated rank placement: 512 MPI ranks on four nodes while
# charging the cpudev maximum of 256 physical CPUs.
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -o logs/
#PBS -V

# Gate B1 of the macrophysics transliteration: the stage runs as its two
# halves -- tphysbc stopped just before call macrop_driver_tend and resumed
# just after -- with NO Python process installed, so the resume calls the
# original Fortran driver itself.  Every FLOP is therefore the oracle's; what
# is on trial is the stop/resume, the idempotence of what precedes the call,
# and the handle storage.  bfb: true is the only acceptable result.
#
# Set PYCAM_SPLIT_MACROPHYSICS=0 to run the same image with the stage whole,
# which is the baseline this gate is compared against.

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_STATE_CASE}
oracle_run=${FREECAM_REFERENCE_RUN}
mode=${PYCAM_EXECUTION_MODE:-fine_grained}
split=${PYCAM_SPLIT_MACROPHYSICS:-1}
label=$([[ "${split}" == 1 ]] && echo split || echo whole)
run_dir=${FREECAM_SCRATCH}/pyCAM/PI-cam/macro-tend-${label}-${mode}-${PBS_JOBID}/run
boundary=${FREECAM_SCRATCH}/pyCAM/PI-cam/nonpic-boundary-capture-50step/boundary/replay
manifest=${PYCAM_NATIVE_MANIFEST:-${repo}/build/pi_cam_promoted/native_cam_manifest.json}
summary=${PYCAM_SUMMARY:-validation/pi_cam_macro_tend_${label}_50step.json}
bfb_output=${PYCAM_BFB_OUTPUT:-validation/pi_cam_macro_tend_${label}_vs_oracle_50step_bfb.json}

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=${FREECAM_LD_PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

mkdir -p "${run_dir}"
rsync -a \
  --exclude 'f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step.*' \
  --exclude '*.log.*' --exclude 'rpointer.*' --exclude 'timing/' \
  "${oracle_run}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"

cd "${repo}"
split_args=()
if [[ "${split}" == 1 ]]; then
  split_args+=(--split-macrophysics)
fi
mpiexec --label -n 512 "${python}" -m freecam.pi_cam.cli \
  --config configs/pi_cam_icesm131_replay.yaml \
  --native-manifest "${manifest}" \
  --boundary "${boundary}" \
  --run-dir "${run_dir}" \
  --execution-mode "${mode}" \
  "${split_args[@]}" \
  --steps 50 \
  --summary "${summary}" \
  > "${run_dir}/pi_cam_python.log" 2>&1

"${python}" tools/verify_pi_cam.py \
  --reference "${oracle_run}" \
  --candidate "${run_dir}" \
  --output "${bfb_output}"
