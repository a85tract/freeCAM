#!/bin/bash
#PBS -N pycesm-pi-atm-native-50
#PBS -A UCUB0188
# The verified layout has 512 MPI ranks. For the 256-CPU cpudev queue we keep
# the supported density of 128 ranks/node and place two ranks on each CPU.
#PBS -q develop
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -V

set -euo pipefail

repo=/glade/work/ruitong/pycam-sima
case_root=/glade/work/ruitong/CESM_cases/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-atm.pycesm-pic
run_dir=/glade/derecho/scratch/ruitong/pyCESM/PI-atm/python-native-50step/run

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
# mpi4py's MPICH-ABI extension requests libmpi.so.12; Cray provides that
# compatibility name in lib-abi-mpich and points it at this case's MPI build.
export LD_LIBRARY_PATH="/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0/lib-abi-mpich:${LD_LIBRARY_PATH}"
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

cd "${run_dir}"
mpiexec --label -n 512 \
  "${repo}/.venv/bin/python" -m pycam_sima.cesm.cli run-native-reference \
  --config "${repo}/configs/pi_atm_icesm131.yaml" \
  --run-dir "${run_dir}" \
  --library "${repo}/build/cesm/pi_atm/libpycesm_full.so" \
  --steps 50 \
  > pycesm-native.log 2>&1
