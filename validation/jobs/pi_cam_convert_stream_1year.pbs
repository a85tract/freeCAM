#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_convert_stream_1year.pbs
#PBS -N freecam-convert-1year
#PBS -q develop
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=80GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o logs/
#PBS -V

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
output_root=${FREECAM_SCRATCH}/freeCAM/PI-cam/stream-boundary-1year
capture_prefix=${output_root}/boundary/raw/pi_cam
replay_root=${output_root}/boundary/replay

rm -rf "${replay_root}"
cd "${repo}"
PYTHONPATH=${repo}/src ${repo}/.venv/bin/python \
  tools/convert_pi_cam_boundary.py \
  --capture-prefix "${capture_prefix}" \
  --output "${replay_root}" \
  --config configs/pi_cam_icesm131_1year.yaml \
  --summary validation/pi_cam_stream_boundary_1year.json

