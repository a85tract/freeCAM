#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_stream_capture_build.pbs
#PBS -N freecam-stream-build
#PBS -q develop
#PBS -l select=1:ncpus=1:mpiprocs=1:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o logs/
#PBS -V

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_REFERENCE_CASE}
source_root=${repo}/external/iCESM1.3.1_fzhu
output_root=${repo}/build/pi_cam_stream

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
export PYTHONPATH=${repo}/src

cd "${repo}"
mkdir -p "${output_root}"
"${python}" tools/build_pi_cam_capture.py \
  --case "${case_root}" \
  --source-root "${source_root}" \
  --output "${output_root}/pi_cam_capture.exe" \
  --manifest "${output_root}/capture-manifest.json"
