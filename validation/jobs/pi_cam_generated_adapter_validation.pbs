#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_generated_adapter_validation.pbs
#PBS -N freecam-adapter-gate
#PBS -q develop
#PBS -l select=1:ncpus=32:mpiprocs=1:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o logs/
#PBS -V

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
case_root=${FREECAM_STATE_CASE}
work_root=${FREECAM_SCRATCH}/pyCAM/PI-cam/adapter-validation-${PBS_JOBID}

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
export PYTHONPATH=${repo}/src

cd "${repo}"
"${repo}/.venv/bin/python" -m freecam.cli validate-pi-cam-adapters \
  --descriptor-root "${repo}/build/pi_cam_kernel_catalog" \
  --compiler "$(command -v ftn)" \
  --context-file "${repo}/validation/pi_cam_adapter_build_contexts.yaml" \
  --work-root "${work_root}" \
  --workers 32 \
  --require-all-compile \
  --require-all-abi-smoke \
  --output "${repo}/validation/pi_cam_generated_adapter_validation.json"
