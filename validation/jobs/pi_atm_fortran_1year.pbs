#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_atm_fortran_1year.pbs
#PBS -N fortran-1year
#PBS -q cpudev
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o logs/
#PBS -V

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
case_root=${FREECAM_PYCESM_CASE}
executable=${FREECAM_SCRATCH}/pyCESM/PI-atm/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-atm.pycesm-ref.50step/bld/cesm.exe
seed=${FREECAM_SCRATCH}/pyCESM/PI-atm/oracle-1month/run
root=${FREECAM_SCRATCH}/freeCAM/PI-cam/original-fortran-one-year-reference
run_dir=${root}/run

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

rm -rf "${root}"
mkdir -p "${run_dir}"
rsync -a \
  --exclude '*.cam.*.nc' --exclude '*.clm2.*.nc' --exclude '*.cice.*.nc' \
  --exclude '*.cpl.*.nc' --exclude '*.rtm.*.nc' --exclude '*.bin' \
  --exclude '*.log.*' --exclude 'rpointer.*' --exclude 'timing/' \
  "${seed}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"
perl -0pi -e 's/restart_n = 1488/restart_n = 17520/; s/stop_n = 1488/stop_n = 17520/' \
  "${run_dir}/drv_in"

cd "${run_dir}"
mpiexec --label -n 512 "${executable}" > original-fortran.log 2>&1

sha256sum "${executable}" > "${root}/executable.sha256"
printf '%s\n' "${PBS_JOBID}" > "${root}/pbs_job_id"
