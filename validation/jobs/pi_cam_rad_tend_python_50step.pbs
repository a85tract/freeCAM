#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_rad_tend_python_50step.pbs
#PBS -N pycam-rad-tend-py-50
#PBS -q develop
# Preserve the validated rank placement: 512 MPI ranks on four nodes while
# charging the cpudev maximum of 256 physical CPUs.
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o logs/
#PBS -V

# Gate R-B2 of the radiation transliteration: the stage runs as its two
# halves and Radiation.tend runs between them on every rank -- the radiation
# driver layer as Python, every FLOP still the oracle's Fortran through the
# lifted kernels, the handles and the two RRTMG cores.  What is on trial is
# the transliteration itself: its order, its argument bindings, its copies.
# bfb: true is the only acceptable result; a difference is diagnosed against
# Gate R-B1's run of the same image, which differs from this one by exactly
# the Python process.
#
# The per-argument trace against a capture of the oracle runs only when
# PYCAM_CAPTURE_BUNDLE names one.  There is no rad_rrtmg capture yet -- it
# needs its own capture-executable patch and run -- so by default this gate
# is the bit-for-bit comparison alone, which is the decisive one.

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_STATE_CASE}
oracle_run=${FREECAM_REFERENCE_RUN}
mode=${PYCAM_EXECUTION_MODE:-fine_grained}
run_dir=${FREECAM_SCRATCH}/pyCAM/PI-cam/rad-tend-python-${mode}-${PBS_JOBID}/run
boundary=${FREECAM_SCRATCH}/pyCAM/PI-cam/nonpic-boundary-capture-50step/boundary/replay
manifest=${PYCAM_NATIVE_MANIFEST:-${repo}/build/pi_cam_promoted/native_cam_manifest.json}
summary=${PYCAM_SUMMARY:-validation/pi_cam_rad_tend_python_50step.json}
bfb_output=${PYCAM_BFB_OUTPUT:-validation/pi_cam_rad_tend_python_vs_oracle_50step_bfb.json}
# The oracle's own mmacro_pcond arguments for steps 1 and 2, every chunk of
# every rank, from the reviewed capture.  tend() traces the same arguments;
# the two are compared after the run whether or not the run was bit-for-bit.
capture_bundle=${PYCAM_CAPTURE_BUNDLE:-}
trace_output=${PYCAM_TRACE_OUTPUT:-validation/pi_cam_rad_tend_python_trace_vs_capture.json}
export FREECAM_RAD_TRACE=${run_dir}/rad_trace
# Per-rank timing of every handle entry, kernel and trace hash by name.
export FREECAM_RAD_PROFILE=${run_dir}/rad_profile

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=${FREECAM_LD_PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

mkdir -p "${run_dir}"
rsync -a \
  --exclude 'f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step.*' \
  --exclude '*.log.*' --exclude 'rpointer.*' --exclude 'timing/' \
  "${oracle_run}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"

cd "${repo}"
mpiexec --label -n 512 "${python}" -m freecam.pi_cam.cli \
  --config configs/pi_cam_icesm131_replay.yaml \
  --native-manifest "${manifest}" \
  --boundary "${boundary}" \
  --run-dir "${run_dir}" \
  --execution-mode "${mode}" \
  --split-radiation \
  --radiation-python \
  --steps 50 \
  --summary "${summary}" \
  > "${run_dir}/pi_cam_python.log" 2>&1 || echo "model run exited $? (comparing the trace anyway)"

status=0
"${python}" tools/verify_pi_cam.py \
  --reference "${oracle_run}" \
  --candidate "${run_dir}" \
  --output "${bfb_output}" || status=$?

if [[ -n "${capture_bundle}" ]]; then
  "${python}" tools/compare_pi_cam_stage_trace.py \
    --bundle "${capture_bundle}" \
    --trace "${run_dir}/rad_trace" \
    --prefix rad --kernel rad_rrtmg_sw \
    --output "${trace_output}" || true
else
  echo "no radiation capture bundle given; the bit-for-bit comparison stands alone"
fi
echo "--- where the Python stage's time went (mean per rank) ---"
"${python}" tools/summarize_stage_profile.py "${run_dir}/rad_profile" --prefix rad --top 25 \
  --output "${run_dir}/rad_profile_summary.json" || true
exit "${status}"
