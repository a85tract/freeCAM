#!/bin/bash
# Fresh original-Fortran performance sample for the FreeCAM month comparison.
# Submit with: qsub -q develop -A <account> validation/jobs/pi_atm_fortran_1month_performance.pbs
#PBS -N fortran-1month
#PBS -q cpudev
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /glade/work/ruitong/freeCAM/logs/
#PBS -V

set -euo pipefail

repo=/glade/work/ruitong/freeCAM
python=${repo}/.venv/bin/python
case_root=/glade/work/ruitong/CESM_cases/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-atm.pycesm-ref.50step
executable=/glade/derecho/scratch/ruitong/pyCESM/PI-atm/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-atm.pycesm-ref.50step/bld/cesm.exe
oracle_run=/glade/derecho/scratch/ruitong/pyCESM/PI-atm/oracle-1month/run
root=/glade/derecho/scratch/ruitong/freeCAM/PI-cam/original-fortran-one-month-${PBS_JOBID}
run_dir=${root}/run
bfb=${root}/bfb.json

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

mkdir -p "${run_dir}"
rsync -a \
  --exclude '*.nc' --exclude '*.bin' --exclude '*.log.*' \
  --exclude 'rpointer.*' --exclude 'timing/' \
  "${oracle_run}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"

cd "${run_dir}"
mpiexec --label -n 512 "${executable}" > original-fortran.log 2>&1

cd "${repo}"
"${python}" tools/verify_pi_cam.py \
  --reference "${oracle_run}" \
  --candidate "${run_dir}" \
  --output "${bfb}"

cp "${bfb}" validation/pi_atm_fortran_rerun_vs_oracle_1month_bfb.json
cp "${run_dir}/timing/cesm_timing.000" \
  validation/pi_atm_fortran_1month_timing.000
