#!/bin/bash
#PBS -N pycam-macro-tend-py-50
#PBS -q develop
# Preserve the validated rank placement: 512 MPI ranks on four nodes while
# charging the cpudev maximum of 256 physical CPUs.
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o logs/
#PBS -V

# Gate B2 of the macrophysics transliteration: the stage runs as its two
# halves and Macrophysics.tend runs between them on every rank -- the
# macrophysics driver layer as Python, every FLOP still the oracle's Fortran
# through the lifted kernels, the handles and the direct kernel.  What is on
# trial is the transliteration itself: its order, its argument bindings, its
# copies.  bfb: true is the only acceptable result; a difference is diagnosed
# against Gate B1's run of the same image, which differs from this one by
# exactly the Python process.

set -euo pipefail

repo=/glade/work/$USER/freeCAM
python=${repo}/.venv/bin/python
case_root=/glade/work/$USER/CESM_cases/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-python-state
oracle_run=/glade/derecho/scratch/$USER/pyCAM/PI-cam/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step/run
mode=${PYCAM_EXECUTION_MODE:-fine_grained}
run_dir=/glade/derecho/scratch/$USER/pyCAM/PI-cam/macro-tend-python-${mode}-${PBS_JOBID}/run
boundary=/glade/derecho/scratch/$USER/pyCAM/PI-cam/nonpic-boundary-capture-50step/boundary/replay
manifest=${PYCAM_NATIVE_MANIFEST:-${repo}/build/pi_cam_promoted/native_cam_manifest.json}
summary=${PYCAM_SUMMARY:-validation/pi_cam_macro_tend_python_50step.json}
bfb_output=${PYCAM_BFB_OUTPUT:-validation/pi_cam_macro_tend_python_vs_oracle_50step_bfb.json}

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=/glade/u/apps/common/23.04/spack/opt/spack/intel-oneapi-compilers/2023.0.0/compiler/2023.0.0/linux/compiler/lib/intel64_lin/libimf.so${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

mkdir -p "${run_dir}"
rsync -a \
  --exclude 'f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step.*' \
  --exclude '*.log.*' --exclude 'rpointer.*' --exclude 'timing/' \
  "${oracle_run}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"

cd "${repo}"
mpiexec --label -n 512 "${python}" -m freecam.pi_cam.cli \
  --config configs/pi_cam_icesm131_replay.yaml \
  --native-manifest "${manifest}" \
  --boundary "${boundary}" \
  --run-dir "${run_dir}" \
  --execution-mode "${mode}" \
  --split-macrophysics \
  --macrophysics-python \
  --steps 50 \
  --summary "${summary}" \
  > "${run_dir}/pi_cam_python.log" 2>&1

"${python}" tools/verify_pi_cam.py \
  --reference "${oracle_run}" \
  --candidate "${run_dir}" \
  --output "${bfb_output}"
