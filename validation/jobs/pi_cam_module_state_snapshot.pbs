#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_module_state_snapshot.pbs
#PBS -N freecam-state-snapshot
#PBS -q develop
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o logs/
#PBS -V

# The module state one or more physics routines read, snapshotted from an
# initialized freeCAM model.  PYCAM_SNAPSHOT_FUNCTIONS names the function specs
# (comma-separated); each gets validation/pi_cam_<function>_module_state.json,
# the values a standalone image is given instead of running cam_init, re-read
# after one step to show they are init-time constants.
set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_STATE_CASE}
oracle_run=${FREECAM_REFERENCE_RUN}
run_dir=${FREECAM_SCRATCH}/pyCAM/PI-cam/state-snapshot-${PBS_JOBID}/run
boundary=${FREECAM_SCRATCH}/pyCAM/PI-cam/nonpic-boundary-capture-50step/boundary/replay
manifest=${PYCAM_NATIVE_MANIFEST:-${repo}/build/pi_cam_promoted/native_cam_manifest.json}

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=${FREECAM_LD_PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks

mkdir -p "${run_dir}"
rsync -a \
  --exclude 'f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step.*' \
  --exclude '*.log.*' --exclude 'rpointer.*' --exclude 'timing/' \
  "${oracle_run}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"

cd "${repo}"
function_flags=()
IFS=',' read -ra functions <<< "${PYCAM_SNAPSHOT_FUNCTIONS:?name the function specs to snapshot}"
for name in "${functions[@]}"; do function_flags+=(--function "${name}"); done
mpiexec --label -n 512 "${python}" tools/snapshot_pi_cam_module_state.py \
  --config configs/pi_cam_icesm131_replay.yaml \
  --boundary "${boundary}" \
  --run-dir "${run_dir}" \
  --native-manifest "${manifest}" \
  ${function_flags[@]} \
  --output-dir validation \
  > "${run_dir}/snapshot.log" 2>&1

for name in "${functions[@]}"; do
  "${python}" - "${name}" <<'PY'
import json, sys
from pathlib import Path
name = sys.argv[1]
payload = json.loads(Path(f"validation/pi_cam_{name}_module_state.json").read_text())
print(name, "entries:", len(payload["entries"]), "drifted after one step:", payload["drifted_after_one_step"], "digest:", payload["digest"])
PY
done
