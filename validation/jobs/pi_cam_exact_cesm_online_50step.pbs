#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_exact_cesm_online_50step.pbs
#PBS -N freecam-exact-50
# ``develop`` is the public route; PBS places eligible jobs in ``cpudev``.
#PBS -q develop
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=110GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o logs/
#PBS -V

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_REFERENCE_CASE}
cam_reference=${FREECAM_REFERENCE_RUN}
# Overridable, so the gate runs on an image and a coupler library built beside the ones in use:
#   FREECAM_CESM_REFERENCE_RUN  the original coupled model's 50-step run (its namelists)
#   PYCAM_NATIVE_MANIFEST       the image (default: the configuration's)
#   PYCAM_RUN_TAG               names the records, validation/pi_cam_exact_cesm_online_<tag>_50step*.json
#   PYCAM_CONFIG                the case configuration (default the exact online 50-step one)
#   FREECAM_PROVIDER_ORACLE     the captured exchange the provider checks itself against; empty: none
#   FREECAM_RECORD_DIR          where the records go (default validation)
#   PYCAM_STATE=1               also record state snapshots, for `freecam globe <root>/state`
#   PYCAM_STATE_FIELDS          the fields (default T,Q,CLDLIQ,CLDICE)
#   PYCAM_STATE_EVERY           steps between step snapshots (default 1)
#   PYCAM_STATE_ACTION_STEPS    steps also recorded after every plan action (24, 23-24, 12-48/12)
#   PYCAM_STATE_FLUSH_EVERY     snapshots between writes (default 24; 1 as the Workflow Builder records)
cesm_reference=${FREECAM_CESM_REFERENCE_RUN:-${FREECAM_SCRATCH}/pyCESM/PI-atm/oracle-50step-run1/run}
config=${PYCAM_CONFIG:-configs/pi_cam_icesm131_exact_online_50step.yaml}
record_dir=${FREECAM_RECORD_DIR:-validation}
tag=${PYCAM_RUN_TAG:+_${PYCAM_RUN_TAG}}
manifest_flags=()
if [ -n "${PYCAM_NATIVE_MANIFEST:-}" ]; then
  manifest_flags=(--native-manifest "${PYCAM_NATIVE_MANIFEST}")
fi
oracle=${FREECAM_PROVIDER_ORACLE-${FREECAM_SCRATCH}/pyCAM/PI-cam/nonpic-boundary-capture-50step/boundary/replay}
library=${FREECAM_CESM_PROVIDER_LIBRARY:-${repo}/build/cesm/pi_atm/production-components/libpycesm_external_atm.so}
root=${FREECAM_SCRATCH}/pyCAM/PI-cam/exact-cesm-online-50step-${PBS_JOBID}
cam_run=${root}/cam-run
cesm_run=${root}/cesm-provider-run
state_flags=()
if [ "${PYCAM_STATE:-0}" = 1 ]; then
  state_flags=(--state-dir "${root}/state" --state-fields "${PYCAM_STATE_FIELDS:-T,Q,CLDLIQ,CLDICE}"
    --state-every "${PYCAM_STATE_EVERY:-1}" --state-action-steps "${PYCAM_STATE_ACTION_STEPS:-}"
    --state-flush-every "${PYCAM_STATE_FLUSH_EVERY:-24}")
fi

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=${FREECAM_LD_PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

mkdir -p "${cam_run}" "${cesm_run}"
rsync -a --exclude '*.nc' --exclude '*.bin' --exclude '*.log*' \
  --exclude 'rpointer.*' --exclude 'timing/' "${cam_reference}/" "${cam_run}/"
rsync -a --exclude '*.nc' --exclude '*.bin' --exclude '*.log*' \
  --exclude 'rpointer.*' --exclude 'timing/' "${cesm_reference}/" "${cesm_run}/"
cp "${cam_reference}/SEMapping.nc" "${cam_run}/"
cp "${cesm_reference}/SEMapping.nc" "${cesm_run}/"
mkdir -p "${cam_run}/timing/checkpoints" "${cesm_run}/timing/checkpoints"

"${python}" - <<PY
from pathlib import Path
import cloudpickle
from freecam import CESMOnlineBoundaryProvider

provider = CESMOnlineBoundaryProvider(
    library=Path("${library}"),
    run_dir=Path("${cesm_run}"),
    oracle=Path("${oracle}") if "${oracle}" else None,
)
Path("${cam_run}/.exact-cesm-provider.pkl").write_bytes(
    cloudpickle.dumps(provider, protocol=5)
)
PY

cd "${repo}"
mpiexec --label -n 512 "${python}" -m freecam.pi_cam.cli \
  --config "${config}" \
  --boundary-provider "${cam_run}/.exact-cesm-provider.pkl" \
  --run-dir "${cam_run}" \
  --steps 50 \
  --memory-sample-every 10 \
  "${manifest_flags[@]}" \
  "${state_flags[@]}" \
  --summary "${record_dir}/pi_cam_exact_cesm_online${tag}_50step.json" \
  > "${cam_run}/freecam.log" 2>&1

"${python}" tools/verify_pi_cam.py \
  --reference "${cam_reference}" \
  --candidate "${cam_run}" \
  --output "${record_dir}/pi_cam_exact_cesm_online${tag}_50step_bfb.json"
