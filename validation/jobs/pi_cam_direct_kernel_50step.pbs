#!/bin/bash
#PBS -N pycam-direct-kernel-50
#PBS -A $PBS_ACCOUNT
#PBS -q develop
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -o /glade/work/$USER/freeCAM/logs/
#PBS -V

set -euo pipefail

repo=/glade/work/$USER/freeCAM
python=${repo}/.venv/bin/python
case_root=/glade/work/$USER/CESM_cases/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-python-state
oracle_run=/glade/derecho/scratch/$USER/pyCAM/PI-cam/f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step/run
run_dir=/glade/derecho/scratch/$USER/pyCAM/PI-cam/direct-kernel-${PBS_JOBID}/run
boundary=/glade/derecho/scratch/$USER/pyCAM/PI-cam/nonpic-boundary-capture-50step/boundary/replay
manifest=${repo}/build/pi_cam_zero_copy/native_cam_manifest.json

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=/glade/u/apps/common/23.04/spack/opt/spack/intel-oneapi-compilers/2023.0.0/compiler/2023.0.0/linux/compiler/lib/intel64_lin/libimf.so${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

rm -rf "${run_dir}"
mkdir -p "${run_dir}"
rsync -a \
  --exclude 'f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step.*' \
  --exclude '*.log.*' --exclude 'rpointer.*' --exclude 'timing/' \
  "${oracle_run}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"

cd "${repo}"
mpiexec --label -n 512 "${python}" tools/validate_pi_cam_direct_kernel.py \
  --config configs/pi_cam_icesm131.yaml \
  --boundary "${boundary}" \
  --run-dir "${run_dir}" \
  --native-manifest "${manifest}" \
  --kernel dadadj \
  --steps 50 \
  --output validation/pi_cam_direct_kernel_50step.json \
  > "${run_dir}/pi_cam_direct_kernel.log" 2>&1

"${python}" tools/verify_pi_cam.py \
  --reference "${oracle_run}" \
  --candidate "${run_dir}" \
  --output validation/pi_cam_direct_kernel_vs_oracle_50step_bfb.json
