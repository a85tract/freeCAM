#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_stream_boundary_1year.pbs
#PBS -N freecam-x2a-1year
#PBS -q develop
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o logs/
#PBS -V

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
case_root=${FREECAM_PYCESM_CASE}
reference=${FREECAM_SCRATCH}/freeCAM/PI-cam/original-fortran-one-year-reference/run
output_root=${FREECAM_SCRATCH}/freeCAM/PI-cam/stream-boundary-1year
run_dir=${output_root}/run
capture_prefix=${output_root}/boundary/raw/pi_cam
executable=${repo}/build/pi_cam_stream/pi_cam_capture.exe

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
rm -rf "${output_root}"
mkdir -p "${capture_prefix%/*}" "${run_dir}"
rsync -a \
  --exclude '*.cam.*.nc' --exclude '*.clm2.*.nc' --exclude '*.cice.*.nc' \
  --exclude '*.cpl.*.nc' --exclude '*.rtm.*.nc' --exclude '*.bin' \
  --exclude '*.log*' --exclude 'rpointer.*' --exclude 'timing/' \
  "${reference}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"

export PYCAM_BOUNDARY_CAPTURE=${capture_prefix}
export PYCAM_BOUNDARY_CAPTURE_MODE=stream
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

cd "${run_dir}"
mpiexec --label -n 512 \
  "${executable}" > cesm.log.pi-cam-stream-capture-1year 2>&1

cd "${repo}"
PYTHONPATH=${repo}/src ${repo}/.venv/bin/python \
  tools/verify_pi_cam.py \
  --reference "${reference}" \
  --candidate "${run_dir}" \
  --output validation/pi_cam_stream_capture_vs_fortran_1year_bfb.json

