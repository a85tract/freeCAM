#!/bin/bash
# Submit with: validation/jobs/submit.sh validation/jobs/pi_cam_mm_micro_history_diag.pbs
#PBS -N pycam-mm-micro-diag
#PBS -q develop
#PBS -l select=4:ncpus=64:mpiprocs=128:ompthreads=1:mem=64GB
#PBS -l walltime=00:20:00
#PBS -j oe
#PBS -o logs/
#PBS -V

# A diagnostic, not a gate: run a few steps with history written every step,
# so two forms of the same stage can be compared field by field.  Gate M-3's
# export comparison says only that cam_out differs at step 4; this says which
# physics field differs first, and history carries the microphysics by name.
#
#   PYCAM_FORM=whole-micro | composed     which form of the stage to run
#   PYCAM_STEPS=4                         how many steps
# The run directory is left in place; compare two of them with
#   tools/verify_pi_cam.py --reference <whole-micro run> --candidate <composed run>

set -euo pipefail

source "${FREECAM_REPO:-${PBS_O_WORKDIR:-$PWD}}/validation/jobs/common.sh"

repo=${FREECAM_REPO}
python=${repo}/.venv/bin/python
case_root=${FREECAM_STATE_CASE}
oracle_run=${FREECAM_REFERENCE_RUN}
form=${PYCAM_FORM:-composed}
steps=${PYCAM_STEPS:-4}
run_dir=${FREECAM_SCRATCH}/pyCAM/PI-cam/mm-micro-diag-${form}-${PBS_JOBID}/run
boundary=${FREECAM_SCRATCH}/pyCAM/PI-cam/nonpic-boundary-capture-50step/boundary/replay
manifest=${PYCAM_NATIVE_MANIFEST:-${repo}/build/pi_cam_promoted/native_cam_manifest.json}

source "${case_root}/.env_mach_specific.sh" >/dev/null 2>&1
mpi_root=${CRAY_MPICH_DIR:-/opt/cray/pe/mpich/8.1.25/ofi/intel/19.0}
export LD_LIBRARY_PATH="${mpi_root}/lib-abi-mpich:${mpi_root}/lib:${LD_LIBRARY_PATH:-}"
export LD_PRELOAD=${FREECAM_LD_PRELOAD}${LD_PRELOAD:+:${LD_PRELOAD}}
export PYTHONPATH=${repo}/src
export OMP_NUM_THREADS=1
export OMP_STACKSIZE=64M
export FI_CXI_RX_MATCH_MODE=hybrid
export FI_MR_CACHE_MONITOR=memhooks
export MPICH_MPIIO_HINTS='*:romio_cb_read=enable:romio_cb_write=enable:striping_factor=24'

mkdir -p "${run_dir}"
rsync -a \
  --exclude 'f.e13.F1850C5.ne16_g16.icesm131_ihesp.PI-cam-oracle.50step.*' \
  --exclude '*.log.*' --exclude 'rpointer.*' --exclude 'timing/' \
  "${oracle_run}/" "${run_dir}/"
mkdir -p "${run_dir}/timing/checkpoints"

# history every step, one sample per file, so step 1 is on disk before the
# divergence can hide in a monthly mean
sed -i -e "s/^ *nhtfrq.*/ nhtfrq = 1/" -e "s/^ *mfilt.*/ mfilt = ${steps}/" "${run_dir}/atm_in"

extra=""
if [[ "${form}" == "whole-micro" ]]; then
  extra="--cloud-macro-micro-whole-micro"
fi

cd "${repo}"
mpiexec --label -n 512 "${python}" -m freecam.pi_cam.cli \
  --config configs/pi_cam_icesm131_replay.yaml \
  --native-manifest "${manifest}" \
  --boundary "${boundary}" \
  --run-dir "${run_dir}" \
  --execution-mode fine_grained \
  --cloud-macro-micro-python ${extra} \
  --no-verify-exports \
  --steps "${steps}" \
  > "${run_dir}/pi_cam_python.log" 2>&1 || echo "model run exited $? (the history file is what matters)"

ls -la "${run_dir}"/*.cam.h0.*.nc 2>/dev/null || echo "no history file was written"
echo "run dir: ${run_dir}"
