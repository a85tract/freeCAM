#!/bin/bash
#PBS -N pycam_dask_one
#PBS -A UCUB0188
#PBS -q develop
#PBS -l select=1:ncpus=25:mpiprocs=24:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /glade/work/ruitong/freeCAM/logs/

set -euo pipefail

PROJECT=/glade/work/ruitong/freeCAM
CASE=$PROJECT/reference/cases/FKESSLER_ne3pg3_gnu_24x50
REFERENCE_RUN=/glade/derecho/scratch/ruitong/pycam-sima/FKESSLER_ne3pg3_gnu_24x50/FKESSLER_ne3pg3_gnu_24x50/run
ORACLE_DIR=${ORACLE_DIR:-/glade/derecho/scratch/ruitong/pycam_sima_legacy_oracle_f8daa568/run}
VALIDATION_ROOT=${VALIDATION_ROOT:-/glade/derecho/scratch/ruitong/freecam/dask_allocation/${PBS_JOBID}}

mkdir -p "$VALIDATION_ROOT"
source "$CASE/.env_mach_specific.sh" >/dev/null 2>&1
cd "$PROJECT"

"$PROJECT/.venv/bin/python" tools/dask_allocation_fanout.py \
  --run-root "$VALIDATION_ROOT" \
  --initial-run-dir "$REFERENCE_RUN" \
  --base-steps 25 \
  --continuation-steps 25

"$PROJECT/.venv/bin/python" tools/validate_dask_allocation.py \
  "$VALIDATION_ROOT"

"$PROJECT/.venv/bin/python" -m freecam.cli compare-history \
  "$ORACLE_DIR" "$VALIDATION_ROOT/control/history" \
  --files 51 \
  --numeric-variables 26

echo "FREECAM_DASK_ALLOCATION_BFB root=$VALIDATION_ROOT"
