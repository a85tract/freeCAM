#!/bin/bash
#PBS -N pycam_full_24x50
#PBS -A UCUB0188
#PBS -q develop
#PBS -l select=1:ncpus=24:mpiprocs=24:mem=45GB
#PBS -l walltime=00:20:00
#PBS -j oe

set -euo pipefail

REPO=/glade/work/ruitong/pycam-sima
CASE=$REPO/reference/cases/FKESSLER_ne3pg3_gnu_24x50
RUN_DIR=/glade/derecho/scratch/ruitong/pycam-sima/pyfull_bfb/FKESSLER_ne3pg3_24x50/run

source "$CASE/.env_mach_specific.sh" >/dev/null 2>&1
cd "$REPO"

mpiexec -n 24 "$REPO/.venv/bin/python" -m pycam_sima.cli run-full \
  "$REPO/configs/fkessler_ne3pg3.yaml" \
  --run-dir "$RUN_DIR" \
  --steps 50 \
  --watch air_temperature \
  --watch-event step_end

echo "PYCAM_SIMA_FULL_JOB_OK job=${PBS_JOBID:-unknown} ranks=24 steps=50"
