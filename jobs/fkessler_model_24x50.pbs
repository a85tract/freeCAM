#!/bin/bash
#PBS -A UCUB0188
#PBS -q develop
#PBS -l select=1:ncpus=24:mpiprocs=24:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /glade/work/ruitong/pycam-sima/logs/
#PBS -N pycam_model

set -euo pipefail

PROJECT=/glade/work/ruitong/pycam-sima
RUN_DIR=${RUN_DIR:?set RUN_DIR to a directory containing atm_in}
HISTORY_DIR=${HISTORY_DIR:?set HISTORY_DIR to a new output directory}
STEPS=${STEPS:-50}
LIBRARY=${LIBRARY:-$PROJECT/build/libpycam_sima_kernels.so}

export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export PYTHONFAULTHANDLER=1

cd "$PROJECT"
source reference/cases/FKESSLER_ne3pg3_gnu_24x50/.env_mach_specific.sh >/dev/null 2>&1
exec mpiexec -n 24 "$PROJECT/.venv/bin/python" -m pycam_sima.cli \
  run configs/fkessler_model.yaml \
  --run-dir "$RUN_DIR" \
  --history-dir "$HISTORY_DIR" \
  --library "$LIBRARY" \
  --steps "$STEPS"
