#!/bin/bash
#PBS -N pycam_pyproc
#PBS -A UCUB0188
#PBS -q develop
#PBS -l select=1:ncpus=128:mpiprocs=96:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /glade/work/ruitong/pycam-sima/logs/

set -euo pipefail

PROJECT=/glade/work/ruitong/pycam-sima
CASE=$PROJECT/reference/cases/FKESSLER_ne3pg3_gnu_24x50
ORACLE=/glade/derecho/scratch/ruitong/pycam_sima_legacy_oracle_f8daa568/run
ROOT=/glade/derecho/scratch/ruitong/pycam-sima/python-runtime-process/${PBS_JOBID}
OUTPUT=$ROOT/python_runtime_process.json

source "$CASE/.env_mach_specific.sh" >/dev/null 2>&1
cd "$PROJECT"

"$PROJECT/.venv/bin/python" tools/validate_python_runtime_process.py \
  --run-root "$ROOT/run" \
  --initial-run-dir "$CASE/CaseDocs" \
  --oracle-history "$ORACLE" \
  --output "$OUTPUT"
