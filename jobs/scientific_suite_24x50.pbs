#!/bin/bash
#PBS -N pycam_suite_24x50
#PBS -A UCUB0188
#PBS -q develop
#PBS -l select=1:ncpus=24:mpiprocs=24:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /glade/work/ruitong/pycam-sima/logs/

set -euo pipefail

REPO=${REPO:-/glade/work/ruitong/pycam-sima}
: "${SUITE_CONFIG:?set SUITE_CONFIG to a ModelConfig YAML}"
: "${CASE_ENV:?set CASE_ENV to the suite reference case environment script}"
: "${ORACLE_RUN:?set ORACLE_RUN to the immutable CAM-SIMA run directory}"
: "${CANDIDATE_ROOT:?set CANDIDATE_ROOT to a new output directory}"

RUN_DIR=$CANDIDATE_ROOT/run
HISTORY_DIR=$CANDIDATE_ROOT/history
RESULT_JSON=$CANDIDATE_ROOT/result.json
RUN_STDOUT=$CANDIDATE_ROOT/run.stdout

source "$CASE_ENV" >/dev/null 2>&1
mkdir -p "$RUN_DIR"
test ! -e "$HISTORY_DIR"
cp "$ORACLE_RUN/atm_in" "$RUN_DIR/atm_in"

cd "$REPO"
RUN_ARGS=(
  "$SUITE_CONFIG"
  --run-dir "$RUN_DIR"
  --history-dir "$HISTORY_DIR"
)
if [[ -n "${STEPS:-}" ]]; then
  RUN_ARGS+=(--steps "$STEPS")
fi
mpiexec --hosts "$(hostname -s)" --no-vni -n 24 \
  "$REPO/.venv/bin/python" -m pycam_sima.cli run \
  "${RUN_ARGS[@]}" \
  >"$RUN_STDOUT"
tail -n 1 "$RUN_STDOUT" >"$RESULT_JSON"

if [[ ${SKIP_COMPARE:-0} == 1 ]]; then
  exit 0
fi

COMPARE_ARGS=(
  "$ORACLE_RUN"
  "$HISTORY_DIR"
)
VALIDATION_FIELDS=${VALIDATION_FIELDS:-T,Q,U,V,PS}
COMPARE_ARGS+=(--fields "$VALIDATION_FIELDS")
"$REPO/.venv/bin/python" -m pycam_sima.cli compare-history \
  "${COMPARE_ARGS[@]}"
