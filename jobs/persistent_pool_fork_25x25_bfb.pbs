#!/bin/bash
#PBS -N pycam_actor_bfb
#PBS -A $PBS_ACCOUNT
#PBS -q develop
#PBS -l select=4:ncpus=24:mpiprocs=24:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /glade/work/$USER/freeCAM/logs/

set -euo pipefail

PROJECT=/glade/work/$USER/freeCAM
CASE=$PROJECT/reference/cases/FKESSLER_ne3pg3_gnu_24x50
ORACLE=/glade/derecho/scratch/$USER/pycam_sima_legacy_oracle_f8daa568/run
ROOT=/glade/derecho/scratch/$USER/freecam/persistent-pool-fork-25x25/${PBS_JOBID}
OUTPUT=$ROOT/persistent_pool_fork_25x25_bfb.json

source "$CASE/.env_mach_specific.sh" >/dev/null 2>&1
cd "$PROJECT"

"$PROJECT/.venv/bin/python" tools/validate_persistent_pool_fork_bfb.py \
  --run-root "$ROOT/run" \
  --initial-run-dir "$CASE/CaseDocs" \
  --oracle-history "$ORACLE" \
  --output "$OUTPUT" \
  --fork-step 25 \
  --final-step 50
