#!/bin/bash
#PBS -N pycam_pdask
#PBS -A $PBS_ACCOUNT
#PBS -q develop
#PBS -l select=1:ncpus=25:mpiprocs=24:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /glade/work/$USER/freeCAM/logs/

set -euo pipefail

PROJECT=/glade/work/$USER/freeCAM
CASE=$PROJECT/reference/cases/FKESSLER_ne3pg3_gnu_24x50
INITIAL_RUN_DIR=${INITIAL_RUN_DIR:-$CASE/CaseDocs}
VALIDATION_ROOT=${VALIDATION_ROOT:-/glade/derecho/scratch/$USER/freecam/persistent-validation/${PBS_JOBID}}
OUTPUT=${OUTPUT:-$VALIDATION_ROOT/dask_persistent.json}

source "$CASE/.env_mach_specific.sh" >/dev/null 2>&1
cd "$PROJECT"

"$PROJECT/.venv/bin/python" tools/dask_persistent_smoke.py \
  --run-root "$VALIDATION_ROOT" \
  --initial-run-dir "$INITIAL_RUN_DIR" \
  --output "$OUTPUT"

echo "FREECAM_DASK_PERSISTENT_VALID root=$VALIDATION_ROOT output=$OUTPUT"
