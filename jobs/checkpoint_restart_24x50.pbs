#!/bin/bash
#PBS -N pycam_restart
#PBS -A $PBS_ACCOUNT
#PBS -q develop
#PBS -l select=1:ncpus=24:mpiprocs=24:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /glade/work/$USER/freeCAM/logs/

set -euo pipefail

PROJECT=/glade/work/$USER/freeCAM
CASE=$PROJECT/reference/cases/FKESSLER_ne3pg3_gnu_24x50
REFERENCE_RUN=/glade/derecho/scratch/$USER/pycam-sima/FKESSLER_ne3pg3_gnu_24x50/FKESSLER_ne3pg3_gnu_24x50/run
ORACLE_DIR=${ORACLE_DIR:-/glade/derecho/scratch/$USER/pycam_sima_legacy_oracle_f8daa568/run}
VALIDATION_ROOT=${VALIDATION_ROOT:-/glade/derecho/scratch/$USER/freecam/checkpoint_restart/${PBS_JOBID}}
RUN_DIR=$VALIDATION_ROOT/run
HISTORY_DIR=$VALIDATION_ROOT/history
CHECKPOINT_25=$VALIDATION_ROOT/checkpoint-25
CHECKPOINT_50=$VALIDATION_ROOT/checkpoint-50

mkdir -p "$RUN_DIR"
cp "$REFERENCE_RUN/atm_in" "$RUN_DIR/atm_in"
source "$CASE/.env_mach_specific.sh" >/dev/null 2>&1
cd "$PROJECT"

mpiexec -n 24 "$PROJECT/.venv/bin/python" -m freecam.cli \
  run-segment "$PROJECT/configs/fkessler_model.yaml" \
  --run-dir "$RUN_DIR" \
  --history-dir "$HISTORY_DIR" \
  --library "$PROJECT/build/libpycam_sima_kernels.so" \
  --output-checkpoint "$CHECKPOINT_25" \
  --name first-25 \
  --steps 25 \
  --result-json "$VALIDATION_ROOT/first-25.json"

mpiexec -n 24 "$PROJECT/.venv/bin/python" -m freecam.cli \
  run-segment "$PROJECT/configs/fkessler_model.yaml" \
  --run-dir "$RUN_DIR" \
  --history-dir "$HISTORY_DIR" \
  --library "$PROJECT/build/libpycam_sima_kernels.so" \
  --input-checkpoint "$CHECKPOINT_25" \
  --output-checkpoint "$CHECKPOINT_50" \
  --name second-25 \
  --steps 25 \
  --result-json "$VALIDATION_ROOT/second-25.json"

"$PROJECT/.venv/bin/python" -m freecam.cli compare-history \
  "$ORACLE_DIR" "$HISTORY_DIR" \
  --files 51 \
  --numeric-variables 26

echo "FREECAM_CHECKPOINT_RESTART_BFB root=$VALIDATION_ROOT"
