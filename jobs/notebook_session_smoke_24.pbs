#!/bin/bash
#PBS -N pycam_notebook_24
#PBS -A UCUB0188
#PBS -q develop
#PBS -l select=1:ncpus=25:mpiprocs=24:mem=45GB
#PBS -l walltime=00:20:00
#PBS -j oe

set -euo pipefail

REPO=/glade/work/ruitong/pycam-sima
CASE=$REPO/reference/cases/FKESSLER_ne3pg3_gnu_24x50
REFERENCE=/glade/derecho/scratch/ruitong/pycam-sima/FKESSLER_ne3pg3_gnu_24x50/FKESSLER_ne3pg3_gnu_24x50/run
RUN_DIR=/glade/derecho/scratch/ruitong/pycam-sima/notebook_session_smoke/${PBS_JOBID}/run

mkdir -p "$RUN_DIR"
cp "$REFERENCE/atm_in" "$RUN_DIR/atm_in"
source "$CASE/.env_mach_specific.sh" >/dev/null 2>&1
# Exercise the same no-host-list path used by an ordinary Jupyter kernel.
unset PBS_NODEFILE
cd "$REPO"

"$REPO/.venv/bin/python" tools/notebook_session_smoke.py \
  --config "$REPO/configs/fkessler_ne3pg3.yaml" \
  --run-dir "$RUN_DIR" \
  --env-script "$CASE/.env_mach_specific.sh" \
  --log-path "$RUN_DIR/mpi-worker.log"
