#!/bin/bash
#PBS -N pycam_pool_bfb
#PBS -A UCUB0188
#PBS -q develop
#PBS -l select=2:ncpus=24:mpiprocs=24:ompthreads=1:mem=80GB
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /glade/work/ruitong/pycam-sima/logs/

set -euo pipefail

PROJECT=/glade/work/ruitong/pycam-sima
CASE=$PROJECT/reference/cases/FKESSLER_ne3pg3_gnu_24x50
INITIAL_RUN_DIR=${INITIAL_RUN_DIR:-$CASE/CaseDocs}
ORACLE_HISTORY=${ORACLE_HISTORY:-/glade/derecho/scratch/ruitong/pycam_sima_legacy_oracle_f8daa568/run}
VALIDATION_ROOT=${VALIDATION_ROOT:-/glade/derecho/scratch/ruitong/pycam-sima/persistent-pool-validation/${PBS_JOBID}}
OUTPUT=${OUTPUT:-$VALIDATION_ROOT/persistent_pool_bfb.json}

export OMP_NUM_THREADS=1
export PYTHONUNBUFFERED=1
export PYTHONFAULTHANDLER=1

source "$CASE/.env_mach_specific.sh" >/dev/null 2>&1
cd "$PROJECT"

"$PROJECT/.venv/bin/python" tools/validate_persistent_pool.py \
  --run-root "$VALIDATION_ROOT" \
  --initial-run-dir "$INITIAL_RUN_DIR" \
  --oracle-history "$ORACLE_HISTORY" \
  --output "$OUTPUT" \
  --steps 50
