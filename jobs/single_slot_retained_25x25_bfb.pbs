#!/bin/bash
#PBS -N pycam_1slot
#PBS -A UCUB0188
#PBS -q develop
#PBS -l select=1:ncpus=25:mpiprocs=24:ompthreads=1:mem=80GB
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /glade/work/ruitong/pycam-sima/logs/

set -euo pipefail

PROJECT=/glade/work/ruitong/pycam-sima
CASE=$PROJECT/reference/cases/FKESSLER_ne3pg3_gnu_24x50
ORACLE=/glade/derecho/scratch/ruitong/pycam_sima_legacy_oracle_f8daa568/run
ROOT=/glade/derecho/scratch/ruitong/pycam-sima/single-slot-retained/${PBS_JOBID}
OUTPUT=$ROOT/single_slot_retained.json

source "$CASE/.env_mach_specific.sh" >/dev/null 2>&1
cd "$PROJECT"

"$PROJECT/.venv/bin/python" tools/validate_single_slot_retained.py \
  --run-root "$ROOT/run" \
  --initial-run-dir "$CASE/CaseDocs" \
  --oracle-history "$ORACLE" \
  --output "$OUTPUT" \
  --split-step 25 \
  --final-step 50
