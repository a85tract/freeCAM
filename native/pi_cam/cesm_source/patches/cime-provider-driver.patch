+   endif
+
+   ! Python is authoritative for the scientific run/restart/stop decisions in
+   ! the admitted PI-atm path.  The native time manager is still advanced so
+   ! component ESMF clocks remain intact, and its result is retained as a
+   ! fail-closed BFB oracle.  Diagnostic history-average and profiling alarms
+   ! remain native because they do not select a scientific component action.
+   python_controls_alarms = present(python_step) .or. present(python_ymd) .or. &
+        present(python_tod) .or. present(python_alarm_mask)
+   if (python_controls_alarms) then
+      if (.not. present(python_step) .or. .not. present(python_ymd) .or. &
+          .not. present(python_tod) .or. .not. present(python_alarm_mask)) then
+         status = 9
+         return
+      endif
+      if (python_step /= stepno .or. python_ymd /= ymd .or. python_tod /= tod) then
+         status = 10
+         return
+      endif
+
+      native_control_mask = 0
+      if (atmrun_alarm)  native_control_mask = ibset(native_control_mask,0)
+      if (lndrun_alarm)  native_control_mask = ibset(native_control_mask,1)
+      if (icerun_alarm)  native_control_mask = ibset(native_control_mask,2)
+      if (rofrun_alarm)  native_control_mask = ibset(native_control_mask,3)
+      if (ocnrun_alarm)  native_control_mask = ibset(native_control_mask,4)
+      if (ocnnext_alarm) native_control_mask = ibset(native_control_mask,5)
+      if (restart_alarm) native_control_mask = ibset(native_control_mask,6)
+      if (stop_alarm)    native_control_mask = ibset(native_control_mask,8)
+      if (iand(python_alarm_mask,383) /= native_control_mask) then
+         status = 11
+         return
+      endif
+
+      atmrun_alarm  = btest(python_alarm_mask,0)
+      lndrun_alarm  = btest(python_alarm_mask,1)
+      icerun_alarm  = btest(python_alarm_mask,2)
+      rofrun_alarm  = btest(python_alarm_mask,3)
+      ocnrun_alarm  = btest(python_alarm_mask,4)
+      ocnnext_alarm = btest(python_alarm_mask,5)
+      restart_alarm = btest(python_alarm_mask,6)
+      stop_alarm    = btest(python_alarm_mask,8)
+   endif
+
+   call t_drvstopf('CPL:CLOCK_ADVANCE',cplrun=.true.,hashint=pycesm_hashint(2))
+
+   if (atmrun_alarm)  alarm_mask = ibset(alarm_mask,0)
+   if (lndrun_alarm)  alarm_mask = ibset(alarm_mask,1)
+   if (icerun_alarm)  alarm_mask = ibset(alarm_mask,2)
+   if (rofrun_alarm)  alarm_mask = ibset(alarm_mask,3)
+   if (ocnrun_alarm)  alarm_mask = ibset(alarm_mask,4)
+   if (ocnnext_alarm) alarm_mask = ibset(alarm_mask,5)
+   if (restart_alarm) alarm_mask = ibset(alarm_mask,6)
+   if (history_alarm) alarm_mask = ibset(alarm_mask,7)
+   if (stop_alarm)    alarm_mask = ibset(alarm_mask,8)
+   if (histavg_alarm) alarm_mask = ibset(alarm_mask,9)
+   if (tprof_alarm)   alarm_mask = ibset(alarm_mask,10)
+
+   current_ymd = ymd
+   current_tod = tod
+   pycesm_expected_action = 100
+   pycesm_nested_expected_action = 0
+   pycesm_cam_expected_action = 0
+   pycesm_physics_expected_action = 0
+   pycesm_atm_nested_active = .false.
+   pycesm_step_active = .true.
+ end subroutine cesm_step_begin
+
+!===============================================================================
+! Finish one Python-owned step after the HISTORY action.  Timing and wall-clock
+! policy stay in the original Fortran control module because they use native
+! timers and do not belong to a scientific kernel.
+!===============================================================================
+
+ subroutine cesm_step_end(status)
    implicit none
+   integer, intent(out) :: status
 
-   !------------------------------------------------------------------------
-   ! Finalization of all models
-   !------------------------------------------------------------------------
+101 format( A, 2i8, 12A, A, F8.2, A, F8.2 )
+105 format( A, 2i8, A, f10.2, A, f10.2, A, A, i5, A, A)
+108 format( A, f10.2, A, i8.8)
+109 format( A, 2f10.3)
+
+   status = 0
+   if (.not. pycesm_step_active) then
+      status = 3
+      return
+   endif
+   if (pycesm_expected_action /= 129) then
+      status = 6
+      return
+   endif
+   if (pycesm_atm_nested_active) then
+      status = 7
+      return
+   endif
+
+   call t_drvstartf('CPL:TSTAMP_WRITE',cplrun=.true.)
+   if (tod == 0 .or. info_debug > 1) then
+      if (iamroot_CPLID) then
+         call date_and_time(dstr,tstr)
+         Time_estep = mpi_wtime()
+         cktime = time_estep-time_bstep
+         cktime_acc(1) = cktime_acc(1) + cktime
+         cktime_cnt(1) = cktime_cnt(1) + 1
+         write(logunit,101) ' tStamp_write: model date = ',ymd,tod, &
+              ' wall clock = ',dstr(1:4),'-',dstr(5:6),'-',dstr(7:8),' ', &
+              tstr(1:2),':',tstr(3:4),':',tstr(5:6), &
+              ' avg dt = ',cktime_acc(1)/cktime_cnt(1),' dt = ',cktime
+         Time_bstep = mpi_wtime()
+         call shr_sys_flush(logunit)
+         if (cktime > max_cplstep_time .and. max_cplstep_time > 0.0) then
+            call shr_sys_abort(subname//'Wall clock time exceeds max_cplstep_time')
+         else if (max_cplstep_time < -0.05) then
+            max_cplstep_time = -(max_cplstep_time)*cktime
+         endif
+      endif
+   endif
+   if (tod == 0 .and. wall_time_limit > 0.0_r8 .and. .not. force_stop) then
+      time_erun = mpi_wtime()
+      wall_time = (time_erun - time_brun) / 3600._r8
+      write(logunit,109) subname//' check wall_time_limit: ',wall_time, wall_time_limit
+      if (wall_time > wall_time_limit) then
+         force_stop = .true.
+         force_stop_tod = 0
+         if (trim(force_stop_at) == 'month') then
+            call shr_cal_date2ymd(ymd,year,month,day)
+            month = month + 1
+            do while (month > 12)
+               month = month - 12
+               year = year + 1
+            enddo
+            call shr_cal_ymd2date(year,month,1,force_stop_ymd)
+         elseif (trim(force_stop_at) == 'year') then
+            call shr_cal_date2ymd(ymd,year,month,day)
+            call shr_cal_ymd2date(year+1,1,1,force_stop_ymd)
+         else
+            ymdtmp = ymd
+            call shr_cal_advDateInt(1,'days',ymdtmp,0,force_stop_ymd,todtmp,calendar)
+         endif
+         write(logunit,108) subname//' reached wall_time_limit (hours) =',wall_time_limit, &
+              ' :stop at ',force_stop_ymd
+      endif
+   endif
+   if (tod == 0 .or. info_debug > 1) then
+      if (iamroot_CPLID .or. ocn(ens1)%iamroot_compid .or. &
+          atm(ens1)%iamroot_compid .or. lnd(ens1)%iamroot_compid .or. &
+          ice(ens1)%iamroot_compid .or. glc(ens1)%iamroot_compid .or. &
+          wav(ens1)%iamroot_compid) then
+         call shr_mem_getusage(msize,mrss)
+         write(logunit,105) ' memory_write: model date = ',ymd,tod, &
+              ' memory = ',mrss,' MB (highwater)    ',msize,' MB (usage)', &
+              '  (pe=',iam_GLOID,' comps=',trim(complist)//')'
+      endif
+   endif
+   call t_drvstopf('CPL:TSTAMP_WRITE',cplrun=.true.)
+
+   call t_stopf('CPL:RUN_LOOP',pycesm_hashint(1))
+   call t_drvstartf('CPL:TPROF_WRITE',cplrun=.true.)
+   if (tprof_alarm) then
+      call t_startf('sync1_tprof')
+      call mpi_barrier(mpicom_GLOID,ierr)
+      call t_stopf('sync1_tprof')
+      write(timing_file,'(a,i8.8,a1,i5.5)') trim(tchkpt_dir)//'/model_timing_',ymd,'_',tod
+      call t_prf(filename=trim(timing_file),mpicom=mpicom_GLOID,num_outpe=1)
+      call t_startf('sync2_tprof')
+      call mpi_barrier(mpicom_GLOID,ierr)
+      call t_stopf('sync2_tprof')
+   endif
+   call t_drvstopf('CPL:TPROF_WRITE',cplrun=.true.)
+
+   pycesm_step_active = .false.
+   pycesm_expected_action = 0
+   pycesm_nested_expected_action = 0
+   pycesm_cam_expected_action = 0
+   pycesm_physics_expected_action = 0
+   pycesm_atm_nested_active = .false.
+ end subroutine cesm_step_end
+
+!===============================================================================
+
+ subroutine cesm_run_finish(status)
+   implicit none
+   integer, intent(out) :: status
 
-   call t_barrierf ('CPL:FINAL_BARRIER', mpicom_GLOID)
-   call t_startf ('CPL:FINAL')
+   status = 0
+   if (pycesm_step_active .or. pycesm_atm_nested_active) then
+      status = 3
+      return
+   endif
+   if (.not. pycesm_run_started) return
+   call t_startf('CPL:RUN_LOOP_BSTOP')
+   call mpi_barrier(mpicom_GLOID,ierr)
+   call t_stopf('CPL:RUN_LOOP_BSTOP')
+   Time_end = mpi_wtime()
+   pycesm_run_started = .false.
+ end subroutine cesm_run_finish
+
+!===============================================================================
+! Execute one already-validated PI-atm coupling kernel against the live module
+! state.  This is intentionally fail-closed: actions are added only after an
+! independent capture/replay gate proves the original kernel bit-for-bit.
+! No numerical expression is duplicated here; each branch calls the original
+! CESM routine with the same MCT objects used by cesm_run.
+!===============================================================================
+
+ subroutine cesm_nested_action_call(action_id, loop_complete, status)
+   implicit none
+   integer, intent(in) :: action_id
+   integer, intent(out) :: loop_complete
+   integer, intent(out) :: status
+   integer :: action_status
+   logical :: atm_loop_complete
+
+   status = 0
+   loop_complete = 0
+   action_status = 0
+   atm_loop_complete = .false.
+   if (.not. pycesm_step_active) then
+      status = 3
+      return
+   endif
+   if (.not. atmrun_alarm) then
+      status = 5
+      return
+   endif
+
+   if (action_id == 201) then
+      if (pycesm_expected_action /= 124 .or. pycesm_atm_nested_active) then
+         status = 4
+         return
+      endif
+      call component_run_begin(atm,infodata,seq_flds_x2a_fluxes, &
+           atm_prognostic,'CPL:ATM_RUN_BARRIER','CPL:ATM_RUN', &
+           run_barriers,action_status)
+      if (action_status /= 0) then
+         status = action_status
+         return
+      endif
+      pycesm_atm_nested_active = .true.
+      pycesm_nested_expected_action = 201
+      return
+   endif
+
+   if (.not. pycesm_atm_nested_active .or. &
+       action_id /= pycesm_nested_expected_action + 1) then
+      status = 4
+      return
+   endif
+
+   select case (action_id)
+   case (202)
+      call atm_run_external_begin(Eclock_a,atm(ens1)%cdata_cc, &
+           atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,action_status)
+      pycesm_cam_expected_action = 300
+      pycesm_physics_expected_action = 400
+   case (203:208)
+      call atm_run_action(action_id,Eclock_a,atm(ens1)%cdata_cc, &
+           atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,atm_loop_complete,action_status)
+   case (209)
+      call atm_run_end(Eclock_a,atm(ens1)%cdata_cc, &
+           atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,action_status)
+   case (210)
+      call component_run_end(atm,seq_flds_a2x_fluxes, &
+           'CPL:ATM_RUN',action_status)
+   case default
+      status = 1
+      return
+   end select
+
+   if (action_status /= 0) then
+      status = action_status
+      return
+   endif
+   if (action_id == 208 .and. .not. atm_loop_complete) then
+      pycesm_nested_expected_action = 202
+   else
+      pycesm_nested_expected_action = action_id
+   endif
+   if (atm_loop_complete) loop_complete = 1
+   if (action_id == 210) then
+      pycesm_atm_nested_active = .false.
+      pycesm_expected_action = 125
+   endif
+ end subroutine cesm_nested_action_call
+
+!===============================================================================
+
+ subroutine cesm_external_atm_iteration(loop_complete, status)
+   implicit none
+   integer, intent(out) :: loop_complete
+   integer, intent(out) :: status
+   integer :: action_status
+   logical :: atm_loop_complete
+
+   loop_complete = 0
+   status = 0
+   action_status = 0
+   atm_loop_complete = .false.
+   if (.not. pycesm_step_active .or. .not. pycesm_atm_nested_active) then
+      status = 3
+      return
+   endif
+   if (.not. atmrun_alarm .or. pycesm_nested_expected_action /= 202) then
+      status = 5
+      return
+   endif
+
+   call atm_run_external_iteration(Eclock_a,atm(ens1)%cdata_cc, &
+        atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,atm_loop_complete, &
+        action_status)
+   if (action_status /= 0) then
+      status = action_status
+      return
+   endif
+   if (atm_loop_complete) then
+      loop_complete = 1
+      pycesm_nested_expected_action = 209
+   else
+      ! The original ATM do-while loop remains inside the same component and
+      ! CESM driver step.  Python will provide the next external CAM timestep
+      ! before any component_end or post-ATM coupler action is allowed.
+      pycesm_nested_expected_action = 202
+   endif
+ end subroutine cesm_external_atm_iteration
+
+!===============================================================================
+
+ subroutine cesm_exchange_buffer_query(exchange_id, address, nattr, npoint, &
+      status)
+   implicit none
+   integer, intent(in) :: exchange_id
+   type(c_ptr), intent(out) :: address
+   integer, intent(out) :: nattr
+   integer, intent(out) :: npoint
+   integer, intent(out) :: status
+
+   address = c_null_ptr
+   nattr = 0
+   npoint = 0
+   status = 0
+   if (num_inst_atm < 1) then
+      status = 3
+      return
+   endif
+   select case (exchange_id)
+   case (1)
+      if (.not. associated(atm(ens1)%x2c_cc%rattr)) then
+         status = 4
+         return
+      endif
+      nattr = size(atm(ens1)%x2c_cc%rattr, 1)
+      npoint = size(atm(ens1)%x2c_cc%rattr, 2)
+      if (nattr > 0 .and. npoint > 0) &
+           address = c_loc(atm(ens1)%x2c_cc%rattr(1,1))
+   case (2)
+      if (.not. associated(atm(ens1)%c2x_cc%rattr)) then
+         status = 4
+         return
+      endif
+      nattr = size(atm(ens1)%c2x_cc%rattr, 1)
+      npoint = size(atm(ens1)%c2x_cc%rattr, 2)
+      if (nattr > 0 .and. npoint > 0) &
+           address = c_loc(atm(ens1)%c2x_cc%rattr(1,1))
+   case default
+      status = 1
+   end select
+ end subroutine cesm_exchange_buffer_query
+
+!===============================================================================
+
+ subroutine cesm_cam_action_call(action_id, loop_complete, status)
+   implicit none
+   integer, intent(in) :: action_id
+   integer, intent(out) :: loop_complete
+   integer, intent(out) :: status
+   integer :: action_status
+   logical :: atm_loop_complete
+
+   status = 0
+   loop_complete = 0
+   action_status = 0
+   atm_loop_complete = .false.
+   if (.not. pycesm_step_active .or. .not. pycesm_atm_nested_active) then
+      status = 3
+      return
+   endif
+   if (.not. atmrun_alarm .or. pycesm_nested_expected_action /= 202) then
+      status = 5
+      return
+   endif
+   if (action_id /= pycesm_cam_expected_action + 1) then
+      status = 4
+      return
+   endif
+
+   call atm_run_granular_action(action_id,Eclock_a,atm(ens1)%cdata_cc, &
+        atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,atm_loop_complete,action_status)
+   if (action_status /= 0) then
+      status = action_status
+      return
+   endif
+
+   if (action_id == 310 .and. .not. atm_loop_complete) then
+      pycesm_cam_expected_action = 300
+   else
+      pycesm_cam_expected_action = action_id
+   endif
+   if (atm_loop_complete) then
+      loop_complete = 1
+      pycesm_nested_expected_action = 208
+   endif
+ end subroutine cesm_cam_action_call
+
