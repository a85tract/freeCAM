+      call t_stopf  ('CPL:FINAL')
+      call t_prf(trim(timing_dir)//'/cesm_timing', mpicom_GLOID)
+      call t_finalizef()
+   case default
+      status = 3
+      return
+   end select
+
+   pycesm_final_expected_action = action_id
