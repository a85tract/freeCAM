+      status = 4
+      return
+   endif
+
+   call atm_run_physics_action(action_id,Eclock_a,atm(ens1)%cdata_cc, &
+        atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,atm_loop_complete,action_status)
+   if (action_status /= 0) then
+      status = action_status
+      return
+   endif
+
+   if (action_id == 432 .and. .not. atm_loop_complete) then
+      pycesm_physics_expected_action = 400
+   else
+      pycesm_physics_expected_action = action_id
+   endif
+   if (atm_loop_complete) then
