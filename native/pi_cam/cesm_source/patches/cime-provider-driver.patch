+      pycesm_releaser_pointer = c_null_funptr
+      pycesm_allocation_sequence = 0_c_int64_t
+      if (allocated(pycesm_owned_buffers)) deallocate(pycesm_owned_buffers)
+ end subroutine pycesm_mct_clear_allocator_v1
+
+ subroutine pycesm_remember_buffer(address)
+      type(c_ptr), intent(in) :: address
+      type(c_ptr), allocatable :: grown(:)
+      integer :: capacity
+
+      if (.not. allocated(pycesm_owned_buffers)) then
+         allocate(pycesm_owned_buffers(128))
+         pycesm_owned_buffers = c_null_ptr
+      elseif (pycesm_owned_buffer_count == size(pycesm_owned_buffers)) then
+         capacity = 2 * size(pycesm_owned_buffers)
+         allocate(grown(capacity))
+         grown = c_null_ptr
+         grown(1:pycesm_owned_buffer_count) = &
+              pycesm_owned_buffers(1:pycesm_owned_buffer_count)
+         call move_alloc(grown, pycesm_owned_buffers)
+      endif
+      pycesm_owned_buffer_count = pycesm_owned_buffer_count + 1
+      pycesm_owned_buffers(pycesm_owned_buffer_count) = address
+ end subroutine pycesm_remember_buffer
+
+ logical function pycesm_forget_buffer(address)
+      type(c_ptr), intent(in) :: address
+      integer :: index
+      integer(c_int32_t) :: release_status
+
+      pycesm_forget_buffer = .false.
+      do index = 1, pycesm_owned_buffer_count
+         if (c_associated(address, pycesm_owned_buffers(index))) then
+            release_status = 0_c_int32_t
+            if (associated(pycesm_releaser)) then
+               call pycesm_releaser(address, release_status)
+            endif
+            pycesm_owned_buffers(index) = &
+                 pycesm_owned_buffers(pycesm_owned_buffer_count)
+            pycesm_owned_buffers(pycesm_owned_buffer_count) = c_null_ptr
+            pycesm_owned_buffer_count = pycesm_owned_buffer_count - 1
+            pycesm_forget_buffer = .true.
+            return
+         endif
+      enddo
+ end function pycesm_forget_buffer
+
+ subroutine pycesm_request_buffer(kind_code, item_bytes, attribute_count, &
+      point_count, names, address, status)
+      integer(c_int32_t), intent(in) :: kind_code
+      integer(c_int32_t), intent(in) :: item_bytes
+      integer, intent(in) :: attribute_count
+      integer, intent(in) :: point_count
+      character(len=*), intent(in) :: names
+      type(c_ptr), intent(out) :: address
+      integer(c_int32_t), intent(out) :: status
+      character(kind=c_char), allocatable :: c_names(:)
+      integer :: index, name_length
+
+      address = c_null_ptr
+      status = 0_c_int32_t
+      if (.not. associated(pycesm_allocator)) then
+         status = 1_c_int32_t
+         return
+      endif
+      name_length = len_trim(names)
+      allocate(c_names(name_length + 1))
+      do index = 1, name_length
+         c_names(index) = names(index:index)
+      enddo
+      c_names(name_length + 1) = c_null_char
+      pycesm_allocation_sequence = pycesm_allocation_sequence + 1_c_int64_t
+      address = pycesm_allocator(&
+           kind_code, pycesm_allocation_sequence, item_bytes, &
+           int(attribute_count, c_int32_t), int(point_count, c_int64_t), &
+           c_names, status)
+      deallocate(c_names)
+      if (status == 0_c_int32_t .and. c_associated(address)) then
+         call pycesm_remember_buffer(address)
+      elseif (status == 0_c_int32_t) then
+         status = 2_c_int32_t
+      endif
+ end subroutine pycesm_request_buffer
