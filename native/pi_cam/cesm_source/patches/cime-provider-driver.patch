+
+!===============================================================================
+
+ subroutine cesm_action_call(action_id, status)
+   use seq_comm_mct, only : atm_layout, lnd_layout, ice_layout, rof_layout, ocn_layout
+   implicit none
+   integer, intent(in) :: action_id
+   integer, intent(out) :: status
+
+   status = 0
+
+   if (action_id >= 101 .and. action_id <= 129) then
+      if (.not. pycesm_step_active) then
+         status = 3
+         return
+      endif
+      if (action_id <= pycesm_expected_action) then
+         status = 4
+         return
+      endif
+   endif
 
-   call seq_timemgr_EClockGetData( EClock_d, stepno=endstep)
-   call shr_mem_getusage(msize,mrss)
+   if (drv_threading) call seq_comm_setnthreads(nthreads_CPLID)
 
+   select case (action_id)
+   case (1) ! atm_ocn_flux
+      if (trim(aoflux_grid) /= 'ocn' .or. .not. ocn_present) then
+         status = 2
+      else
+         do exi = 1,num_inst_xao
+            eai = mod((exi-1),num_inst_atm) + 1
+            eoi = mod((exi-1),num_inst_ocn) + 1
+            a2x_ox => prep_ocn_get_a2x_ox()
+            o2x_ox => component_get_c2x_cx(ocn(eoi))
+            xao_ox => prep_aoflux_get_xao_ox()
+            call seq_flux_atmocn_mct(infodata, a2x_ox(eai), o2x_ox, xao_ox(exi))
+         enddo
+      endif
+   case (2) ! ocn_albedo
+      if (.not. ocn_present) then
+         status = 2
+      else
+         do exi = 1,num_inst_xao
+            eoi = mod((exi-1),num_inst_ocn) + 1
+            efi = mod((exi-1),num_inst_frc) + 1
+            xao_ox => prep_aoflux_get_xao_ox()
+            call seq_flux_ocnalb_mct(infodata, ocn(1), fractions_ox(efi), xao_ox(exi))
+         enddo
+      endif
+   case (101) ! atm_to_ocn_map
+      if (iamin_CPLID .and. (atm_c2_ocn .or. atm_c2_ice)) then
+         call cesm_comp_barriers(mpicom=mpicom_CPLID,timer='CPL:OCNPRE1_BARRIER')
+         call t_drvstartf('CPL:OCNPRE1',cplrun=.true.,barrier=mpicom_CPLID,hashint=pycesm_hashint(3))
+         call prep_ocn_calc_a2x_ox(timer='CPL:ocnpre1_atm2ocn')
+         call t_drvstopf('CPL:OCNPRE1',cplrun=.true.,hashint=pycesm_hashint(3))
+      endif
+   case (102) ! lnd_prepare
+      if (.not. lndrun_alarm) then
+         status = 5
+      elseif (iamin_CPLID) then
+         call cesm_comp_barriers(mpicom=mpicom_CPLID,timer='CPL:LNDPREP_BARRIER')
+         call t_drvstartf('CPL:LNDPREP',cplrun=.true.,barrier=mpicom_CPLID)
+         if (atm_c2_lnd) call prep_lnd_calc_a2x_lx(timer='CPL:lndprep_atm2lnd')
+         if (lnd_prognostic) then
+            call prep_lnd_mrg(infodata,timer_mrg='CPL:lndprep_mrgx2l')
+            call component_diag(infodata,lnd,flow='x2c',comment='send lnd', &
+                 info_debug=info_debug,timer_diag='CPL:lndprep_diagav')
+         endif
+         call t_drvstopf('CPL:LNDPREP',cplrun=.true.)
+      endif
+   case (103) ! cpl_to_lnd
+      if (.not. lndrun_alarm) then
+         status = 5
+      elseif (iamin_CPLALLLNDID) then
+         call component_exch(lnd,flow='x2c',infodata=infodata, &
+              infodata_string='cpl2lnd_run',mpicom_barrier=mpicom_CPLALLLNDID, &
+              run_barriers=run_barriers,timer_barrier='CPL:C2L_BARRIER', &
+              timer_comp_exch='CPL:C2L',timer_map_exch='CPL:c2l_lndx2lndl', &
+              timer_infodata_exch='CPL:c2l_infoexch')
+      endif
+   case (104) ! ice_prepare
