 CONTAINS
 !================================================================================
+  ! Capture exact rank-local MCT arrays without changing numerical expressions.
+  ! The legacy mode writes one file per record. Stream mode keeps one file open
+  ! per rank, which avoids millions of metadata operations in long runs.
+  subroutine pycam_capture_boundary(direction, step, values)
+    character(len=*), intent(in) :: direction
+    integer, intent(in) :: step
+    real(r8), intent(in) :: values(:,:)
+    character(len=1024), save :: prefix = ''
+    character(len=1024) :: filename
+    character(len=16), parameter :: magic_v1 = 'PYCAM_BOUNDARY1 '
+    character(len=16), parameter :: magic_v2 = 'PYCAM_BOUNDARY2 '
+    character(len=16) :: mode
+    integer :: environment_status, environment_length, mode_length
+    integer :: ierr, unit, direction_id
+    integer :: header(7)
+
+    if (.not. pycam_boundary_capture_checked) then
+       call get_environment_variable('PYCAM_BOUNDARY_CAPTURE', prefix, &
+            length=environment_length, status=environment_status)
+       pycam_boundary_capture_enabled = environment_status == 0 .and. &
+            environment_length > 0
+       if (pycam_boundary_capture_enabled) then
+          call MPI_Comm_rank(mpicom, pycam_boundary_capture_rank, ierr)
+          if (ierr /= 0) call shr_sys_abort('PI-CAM capture MPI_Comm_rank failed')
+          call MPI_Comm_size(mpicom, pycam_boundary_capture_nranks, ierr)
+          if (ierr /= 0) call shr_sys_abort('PI-CAM capture MPI_Comm_size failed')
+          mode = ''
+          call get_environment_variable('PYCAM_BOUNDARY_CAPTURE_MODE', mode, &
+               length=mode_length, status=environment_status)
+          pycam_boundary_capture_stream = environment_status == 0 .and. &
+               trim(mode) == 'stream'
+          if (pycam_boundary_capture_stream) then
+             write(filename, '(a,".rank-",i6.6,".stream.bin")') &
+                  trim(prefix), pycam_boundary_capture_rank
+             open(newunit=pycam_boundary_capture_unit, file=trim(filename), &
+                  access='stream', form='unformatted', status='replace', &
+                  action='write', iostat=ierr)
+             if (ierr /= 0) call shr_sys_abort('cannot open PI-CAM stream capture')
+          endif
+       endif
+       pycam_boundary_capture_checked = .true.
+    endif
+    if (.not. pycam_boundary_capture_enabled) return
+
+    if (trim(direction) == 'import') then
+       direction_id = 1
+    else if (trim(direction) == 'export') then
+       direction_id = 2
+    else
+       call shr_sys_abort('PI-CAM capture direction is invalid')
+    endif
+    if (pycam_boundary_capture_stream) then
+       header = (/ 2, step, pycam_boundary_capture_rank, &
+            pycam_boundary_capture_nranks, direction_id, size(values,1), &
+            size(values,2) /)
+       write(pycam_boundary_capture_unit) magic_v2
+       write(pycam_boundary_capture_unit) header
+       write(pycam_boundary_capture_unit) values
+       return
+    endif
+
+    write(filename, '(a,".step-",i6.6,".rank-",i6.6,".",a,".bin")') &
+         trim(prefix), step, pycam_boundary_capture_rank, trim(direction)
+    open(newunit=unit, file=trim(filename), access='stream', &
+         form='unformatted', status='replace', action='write', iostat=ierr)
+    if (ierr /= 0) call shr_sys_abort('cannot open PI-CAM boundary capture')
+    header = (/ 1, step, pycam_boundary_capture_rank, &
+         pycam_boundary_capture_nranks, direction_id, size(values,1), &
+         size(values,2) /)
+    write(unit) magic_v1
+    write(unit) header
+    write(unit) values
+    close(unit)
+  end subroutine pycam_capture_boundary
+
+  subroutine pycam_close_boundary_capture()
+    integer :: ierr
+    if (pycam_boundary_capture_unit /= 0) then
+       close(pycam_boundary_capture_unit, iostat=ierr)
+       if (ierr /= 0) call shr_sys_abort('cannot close PI-CAM stream capture')
+       pycam_boundary_capture_unit = 0
+    endif
+  end subroutine pycam_close_boundary_capture
+
+!================================================================================
