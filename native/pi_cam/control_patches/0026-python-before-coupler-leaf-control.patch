+subroutine tphysbc_leaf_action(action_id, ztodt, state, tend, pbuf, cam_out, cam_in)
+    use physics_buffer, only: physics_buffer_desc
+    use physics_types, only: physics_state, physics_tend, physics_ptend, physics_update
+    use cam_diagnostics, only: diag_phys_writeout, diag_conv, diag_export
+    use convect_deep, only: convect_deep_tend_2, deep_scheme_does_scav_trans
+    use check_energy, only: check_tracers_chng
+    use time_manager, only: get_nstep
+    use aero_model, only: aero_model_wetdep
+    use carma_intr, only: carma_wetdep_tend
+    use carma_flags_mod, only: carma_do_wetdep
+    use cloud_diagnostics, only: cloud_diagnostics_calc
+    use tropopause, only: tropopause_output
+    use water_tracer_vars, only: trace_water
+    use water_tracers, only: wtrc_mass_fixer
+    use cam_abortutils, only: endrun
+
+    integer, intent(in) :: action_id
+    real(r8), intent(in) :: ztodt
+    type(physics_state), intent(inout) :: state
+    type(physics_tend), intent(inout) :: tend
+    type(physics_buffer_desc), pointer :: pbuf(:)
+    type(cam_out_t), intent(inout) :: cam_out
+    type(cam_in_t), intent(in) :: cam_in
+    type(physics_ptend) :: ptend
+    real(r8) :: dlf(pcols,pver)
+    real(r8) :: zero_tracers(pcols,pcnst)
+    integer :: lchnk, nstep
+
+    lchnk = state%lchnk
+    nstep = get_nstep()
+    zero_tracers = 0._r8
+    dlf = pycesm_bc_dlf(:,:,lchnk)
+
+    select case (action_id)
+    case (12)
+       if ( .not. deep_scheme_does_scav_trans() ) then
+          if (clim_modal_aero .and. .not. prog_modal_aero) then
+             call modal_aero_calcsize_diag(state, pbuf)
+             call modal_aero_wateruptake_dr(state, pbuf)
+          endif
+       endif
+    case (13)
+       if ( .not. deep_scheme_does_scav_trans() ) then
+          call aero_model_wetdep(state, ztodt, dlf, cam_out, ptend, pbuf)
+          call physics_update(state, ptend, ztodt, tend)
+       endif
+    case (14)
+       if ( .not. deep_scheme_does_scav_trans() .and. carma_do_wetdep) then
+          call carma_wetdep_tend(state, ptend, ztodt, pbuf, dlf, cam_out)
+          call physics_update(state, ptend, ztodt, tend)
+       endif
+    case (15)
+       if ( .not. deep_scheme_does_scav_trans() ) then
+          call convect_deep_tend_2(state, ptend, ztodt, pbuf)
+          call physics_update(state, ptend, ztodt, tend)
+          call check_tracers_chng(state, pycesm_bc_tracerint(lchnk), &
+               "cmfmca", nstep, ztodt, zero_tracers)
+       endif
+       if (trace_water) call wtrc_mass_fixer(state)
+    case (16)
+       call diag_phys_writeout(state, cam_out%psl)
+       call diag_conv(state, ztodt, pbuf)
+    case (17)
+       call cloud_diagnostics_calc(state, pbuf)
+    case (18)
+       call tropopause_output(state)
+    case (19)
+       call cam_export(state, cam_out, pbuf)
+    case (20)
+       call diag_export(cam_out)
+    case default
+       call endrun('TPHYSBC_LEAF_ACTION: invalid Python action id')
+    end select
+end subroutine tphysbc_leaf_action
+
