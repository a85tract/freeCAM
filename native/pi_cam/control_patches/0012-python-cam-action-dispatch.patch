 !===============================================================================
 
+ subroutine cesm_cam_action_call(action_id, loop_complete, status)
+   implicit none
+   integer, intent(in) :: action_id
+   integer, intent(out) :: loop_complete
+   integer, intent(out) :: status
+   integer :: action_status
+   logical :: atm_loop_complete
+
+   status = 0
+   loop_complete = 0
+   action_status = 0
+   atm_loop_complete = .false.
+   if (.not. pycesm_step_active .or. .not. pycesm_atm_nested_active) then
+      status = 3
+      return
+   endif
+   if (.not. atmrun_alarm .or. pycesm_nested_expected_action /= 202) then
+      status = 5
+      return
+   endif
+   if (action_id /= pycesm_cam_expected_action + 1) then
+      status = 4
+      return
+   endif
+
+   call atm_run_granular_action(action_id,Eclock_a,atm(ens1)%cdata_cc, &
+        atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,atm_loop_complete,action_status)
+   if (action_status /= 0) then
+      status = action_status
+      return
+   endif
+
+   if (action_id == 310 .and. .not. atm_loop_complete) then
+      pycesm_cam_expected_action = 300
+   else
+      pycesm_cam_expected_action = action_id
+   endif
+   if (atm_loop_complete) then
+      loop_complete = 1
+      pycesm_nested_expected_action = 208
+   endif
+ end subroutine cesm_cam_action_call
