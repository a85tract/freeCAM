+subroutine cam_run4_leaf_action(action_id, rstwr, nlend, status)
+   use cam_history, only: wrapup
+   integer, intent(in) :: action_id
+   logical, intent(in) :: rstwr, nlend
+   integer, intent(out) :: status
+   integer, save :: expected_leaf_action = 1
+
+   status = 0
+   if (action_id < 1 .or. action_id > 3) then
+      status = 1
+      return
+   endif
+   if (action_id /= expected_leaf_action) then
+      status = 4
+      return
+   endif
+   select case (action_id)
+   case (1)
+      call t_startf('cam_run4_wrapup')
+      call wrapup(rstwr, nlend)
+      call t_stopf('cam_run4_wrapup')
+   case (2)
+      if (masterproc .and. print_step_cost) then
+         call t_startf('cam_run4_print')
+         call t_stampf(wcend, usrend, sysend)
+         write(iulog,'(a,3f8.3,a)') &
+              'Prv timestep wallclock, usr, sys=', wcend-wcstart, &
+              usrend-usrstart, sysend-sysstart, ' seconds'
+         call t_stopf('cam_run4_print')
+      endif
+   case (3)
+#ifndef UNICOSMP
+      call t_startf('cam_run4_flush')
+      call shr_sys_flush(iulog)
+      call t_stopf('cam_run4_flush')
+#endif
+   end select
+   if (action_id == 3) then
+      expected_leaf_action = 1
+   else
+      expected_leaf_action = action_id + 1
+   endif
+end subroutine cam_run4_leaf_action
