+
+  implicit none
+  integer, intent(in) :: action_id
+  integer, intent(out) :: status
+#ifdef USE_ESMF_LIB
+  type(ESMF_CplComp) :: drvcomp
+#endif
+
+  status = 0
+  if (action_id == 504) then
+     if (pycesm_init_active) then
+        status = 1
+        return
+     endif
+     pycesm_init_active = .true.
+     pycesm_init_expected_action = 503
+  endif
+  if (.not. pycesm_init_active) then
+     status = 1
+     return
+  endif
+  if (action_id /= pycesm_init_expected_action + 1) then
+     status = 2
+     return
+  endif
 
