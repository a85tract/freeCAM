+         write(logunit,FormatR) subname,' pes max memory last usage (MB)  = ',msize1
+         write(logunit,'(//)')
+         close(logunit)
+      endif
+   case (610)
+      call t_stopf  ('CPL:FINAL')
+      call t_prf(trim(timing_dir)//'/cesm_timing', mpicom_GLOID)
+      call t_finalizef()
+   case default
+      status = 3
+      return
+   end select
 
