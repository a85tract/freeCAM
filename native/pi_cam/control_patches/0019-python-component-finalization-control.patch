  subroutine cesm_final()
+   implicit none
+   integer :: action_id
+   integer :: status
+
+   do action_id = 601, 610
+      call cesm_final_action_call(action_id, status)
+      if (status /= 0) then
+         call shr_sys_abort(subname//' Python finalization action rejected')
+      endif
+   enddo
+
+ end subroutine cesm_final
