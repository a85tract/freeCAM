+ subroutine cesm_final_action_call(action_id, status)
 
    use shr_pio_mod, only : shr_pio_finalize
    implicit none
+   integer, intent(in) :: action_id
+   integer, intent(out) :: status
+
+   status = 0
+   if (action_id == 601) then
+      if (pycesm_final_active .or. pycesm_step_active .or. &
+          pycesm_atm_nested_active) then
+         status = 1
+         return
+      endif
+      pycesm_final_active = .true.
+      pycesm_final_expected_action = 600
+   endif
+
+   if (.not. pycesm_final_active) then
+      status = 1
+      return
+   endif
+   if (action_id /= pycesm_final_expected_action + 1) then
+      status = 2
+      return
+   endif
 
    !------------------------------------------------------------------------
    ! Finalization of all models
    !------------------------------------------------------------------------
 
