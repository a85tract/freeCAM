+ subroutine cesm_nested_action_call(action_id, loop_complete, status)
+   implicit none
+   integer, intent(in) :: action_id
+   integer, intent(out) :: loop_complete
+   integer, intent(out) :: status
+   integer :: action_status
+   logical :: atm_loop_complete
+
+   status = 0
+   loop_complete = 0
+   action_status = 0
+   atm_loop_complete = .false.
+   if (.not. pycesm_step_active) then
+      status = 3
+      return
+   endif
+   if (.not. atmrun_alarm) then
+      status = 5
+      return
+   endif
+
+   if (action_id == 201) then
+      if (pycesm_expected_action /= 124 .or. pycesm_atm_nested_active) then
+         status = 4
+         return
+      endif
+      call component_run_begin(atm,infodata,seq_flds_x2a_fluxes, &
+           atm_prognostic,'CPL:ATM_RUN_BARRIER','CPL:ATM_RUN', &
+           run_barriers,action_status)
+      if (action_status /= 0) then
+         status = action_status
+         return
+      endif
+      pycesm_atm_nested_active = .true.
+      pycesm_nested_expected_action = 201
+      return
+   endif
+
+   if (.not. pycesm_atm_nested_active .or. &
+       action_id /= pycesm_nested_expected_action + 1) then
+      status = 4
+      return
+   endif
+
+   select case (action_id)
+   case (202)
+      call atm_run_begin(Eclock_a,atm(ens1)%cdata_cc, &
+           atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,action_status)
+   case (203:208)
+      call atm_run_action(action_id,Eclock_a,atm(ens1)%cdata_cc, &
+           atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,atm_loop_complete,action_status)
+   case (209)
+      call atm_run_end(Eclock_a,atm(ens1)%cdata_cc, &
+           atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,action_status)
+   case (210)
+      call component_run_end(atm,seq_flds_a2x_fluxes, &
+           'CPL:ATM_RUN',action_status)
+   case default
+      status = 1
+      return
+   end select
+
+   if (action_status /= 0) then
+      status = action_status
+      return
+   endif
+   if (action_id == 208 .and. .not. atm_loop_complete) then
+      pycesm_nested_expected_action = 202
+   else
+      pycesm_nested_expected_action = action_id
+   endif
+   if (atm_loop_complete) loop_complete = 1
+   if (action_id == 210) then
+      pycesm_atm_nested_active = .false.
+      pycesm_expected_action = 125
+   endif
+ end subroutine cesm_nested_action_call
