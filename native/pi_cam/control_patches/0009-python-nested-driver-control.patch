+  subroutine component_run_begin(comp, infodata, seq_flds_x2c_fluxes, &
+       comp_prognostic, timer_barrier, timer_comp_run, run_barriers, status)
+
+    ! Split the non-numerical prologue from component_run so Python can own
+    ! the ordering of the component's internal entry points.  The admitted
+    ! PI-atm path has one ATM instance and one phase; fail closed otherwise.
+    type(component_type)      , intent(inout) :: comp(:)
+    type(seq_infodata_type)   , intent(inout) :: infodata
+    character(len=*)          , intent(in)    :: seq_flds_x2c_fluxes
+    logical                   , intent(in)    :: comp_prognostic
+    character(len=*)          , intent(in)    :: timer_barrier
+    character(len=*)          , intent(in)    :: timer_comp_run
+    logical                   , intent(in)    :: run_barriers
+    integer                   , intent(out)   :: status
+    integer :: ierr
+
+    status = 0
+    if (size(comp) /= 1) then
+       status = 2
+       return
+    endif
+
+    if (comp(1)%oneletterid == 'a') then
+       call seq_infodata_putData(infodata, atm_phase=1)
+    else
+       status = 2
+       return
+    endif
+
+    if (.not. comp(1)%iamin_compid) return
+    if (run_barriers) then
+       call t_drvstartf(trim(timer_barrier))
+       call mpi_barrier(comp(1)%mpicom_compid, ierr)
+       call t_drvstopf(trim(timer_barrier))
+    endif
+    call t_drvstartf(trim(timer_comp_run), barrier=comp(1)%mpicom_compid)
+    if (drv_threading) call seq_comm_setnthreads(comp(1)%nthreads_compid)
+    if (comp_prognostic) then
+       call mct_avect_vecmult(comp(1)%x2c_cc, comp(1)%drv2mdl, &
+            seq_flds_x2c_fluxes, mask_spval=.true.)
+    endif
+  end subroutine component_run_begin
+
+  !===============================================================================
+
+  subroutine component_run_end(comp, seq_flds_c2x_fluxes, timer_comp_run, status)
+
+    ! Complete the exact epilogue paired with component_run_begin.
+    type(component_type), intent(inout) :: comp(:)
+    character(len=*)     , intent(in)   :: seq_flds_c2x_fluxes
+    character(len=*)     , intent(in)   :: timer_comp_run
+    integer              , intent(out)  :: status
+
+    status = 0
+    if (size(comp) /= 1 .or. comp(1)%oneletterid /= 'a') then
+       status = 2
+       return
+    endif
+    if (.not. comp(1)%iamin_compid) return
+    call mct_avect_vecmult(comp(1)%c2x_cc, comp(1)%mdl2drv, &
+         seq_flds_c2x_fluxes, mask_spval=.true.)
+    if (drv_threading) call seq_comm_setnthreads(nthreads_GLOID)
+    call t_drvstopf(trim(timer_comp_run))
+  end subroutine component_run_end
+
