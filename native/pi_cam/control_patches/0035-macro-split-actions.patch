--- a/src/physics/cam/macrop_driver.F90
+++ b/src/physics/cam/macrop_driver.F90
@@ -380 +380 @@ end subroutine macrop_driver_readnl
-             det_s, det_ice)
+             det_s, det_ice, macro_stage)
@@ -407,0 +408 @@ end subroutine macrop_driver_readnl
+  use pycam_macro_split, only: pycam_macro_before, pycam_macro_after
@@ -438,0 +440,6 @@ end subroutine macrop_driver_readnl
+  ! Which half of the routine to run.  Absent or 0 is the original,
+  ! monolithic path: no boundary is published and the kernel call below is
+  ! the untouched one.  1 runs everything up to the kernel and parks what
+  ! the other half needs; 2 resumes from there.  See pycam_macro_split.
+  integer, intent(in), optional :: macro_stage
+
@@ -448,0 +456 @@ end subroutine macrop_driver_readnl
+  integer :: macro_stage_local                      ! 0 monolithic, 1 first half, 2 second half
@@ -620,0 +629,4 @@ end subroutine macrop_driver_readnl
+  macro_stage_local = 0
+  if (present(macro_stage)) macro_stage_local = macro_stage
+  if (macro_stage_local == 2) go to 1000
+
@@ -1028,10 +1040,27 @@ end subroutine macrop_driver_readnl
-   call mmacro_pcond( lchnk, ncol, dtime, state_loc%pmid, state_loc%pdel,        &
-                      t_inout, qv_inout, ql_inout, qi_inout, nl_inout, ni_inout, &                  
-                      ttend, qtend, lmitend, itend, nltend, nitend,              &
-                      CC_T, CC_qv, CC_ql, CC_qi, CC_nl, CC_ni, CC_qlst,          & 
-                      dlf_T, dlf_qv, dlf_ql, dlf_qi, dlf_nl, dlf_ni,             &
-                      concld_old, concld, clrw_old, clri_old, landfrac, snowh,   &
-                      tke, qtl_flx, qti_flx, cmfr_det, qlr_det, qir_det,         &
-                      tlat, qvlat, qcten, qiten, ncten, niten,                   &
-                      cmeliq, qvadj, qladj, qiadj, qllim, qilim,                 &
-                      cld, alst, aist, qlst, qist, do_cldice ) 
+   call pycam_macro_before(macro_stage_local, &
+        lchnk, ncol, dtime, state_loc%pmid, state_loc%pdel, t_inout, &
+        qv_inout, ql_inout, qi_inout, nl_inout, ni_inout, ttend, qtend, &
+        lmitend, itend, nltend, nitend, CC_T, CC_qv, CC_ql, CC_qi, CC_nl, &
+        CC_ni, CC_qlst, dlf_T, dlf_qv, dlf_ql, dlf_qi, dlf_nl, dlf_ni, &
+        concld_old, concld, clrw_old, clri_old, landfrac, snowh, tke, &
+        qtl_flx, qti_flx, cmfr_det, qlr_det, qir_det, tlat, qvlat, qcten, &
+        qiten, ncten, niten, cmeliq, qvadj, qladj, qiadj, qllim, qilim, cld, &
+        alst, aist, qlst, qist, do_cldice, cldsice, cldst, fice, icecldf, &
+        liqcldf, mr_ccice, mr_ccliq, mr_lsice, mr_lsliq, nqctn, nqitn, pqctn, &
+        pqitn, process_rates, state_loc, ptend_loc)
+
+   if (macro_stage_local == 1) then
+      ! The kernel boundary is published; Python runs between the halves.
+      call t_stopf('mmacro_pcond')
+      return
+   end if
+
+1000 continue
+   if (macro_stage_local == 2) call t_startf('mmacro_pcond')
+   call pycam_macro_after(macro_stage_local, &
+        lchnk, tlat, qvlat, qcten, qiten, ncten, niten, cmeliq, qvadj, qladj, &
+        qiadj, qllim, qilim, cld, alst, aist, qlst, qist, t_inout, qv_inout, &
+        ql_inout, qi_inout, nl_inout, ni_inout, clrw_old, clri_old, dlf_ql, &
+        dlf_qi, cldsice, cldst, fice, icecldf, liqcldf, mr_ccice, mr_ccliq, &
+        mr_lsice, mr_lsliq, nqctn, nqitn, pqctn, pqitn, process_rates, &
+        state_loc, ptend_loc)
