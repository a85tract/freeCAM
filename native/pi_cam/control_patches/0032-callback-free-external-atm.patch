+ subroutine cesm_external_atm_iteration(loop_complete, status)
+   implicit none
+   integer, intent(out) :: loop_complete
+   integer, intent(out) :: status
+   integer :: action_status
+   logical :: atm_loop_complete
+
+   loop_complete = 0
+   status = 0
+   action_status = 0
+   atm_loop_complete = .false.
+   if (.not. pycesm_step_active .or. .not. pycesm_atm_nested_active) then
+      status = 3
+      return
+   endif
+   if (.not. atmrun_alarm .or. pycesm_nested_expected_action /= 202) then
+      status = 5
+      return
+   endif
+
+   call atm_run_external_iteration(Eclock_a,atm(ens1)%cdata_cc, &
+        atm(ens1)%x2c_cc,atm(ens1)%c2x_cc,atm_loop_complete, &
+        action_status)
+   if (action_status /= 0) then
+      status = action_status
+      return
+   endif
+   if (atm_loop_complete) then
+      loop_complete = 1
+      pycesm_nested_expected_action = 209
+   else
+      ! The original ATM do-while loop remains inside the same component and
+      ! CESM driver step.  Python will provide the next external CAM timestep
+      ! before any component_end or post-ATM coupler action is allowed.
+      pycesm_nested_expected_action = 202
+   endif
+ end subroutine cesm_external_atm_iteration
