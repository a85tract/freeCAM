+ subroutine cesm_exchange_buffer_query(exchange_id, address, nattr, npoint, &
+      status)
+   implicit none
+   integer, intent(in) :: exchange_id
+   type(c_ptr), intent(out) :: address
+   integer, intent(out) :: nattr
+   integer, intent(out) :: npoint
+   integer, intent(out) :: status
+
+   address = c_null_ptr
+   nattr = 0
+   npoint = 0
+   status = 0
+   if (num_inst_atm < 1) then
+      status = 3
+      return
+   endif
+   select case (exchange_id)
+   case (1)
+      if (.not. associated(atm(ens1)%x2c_cc%rattr)) then
+         status = 4
+         return
+      endif
+      nattr = size(atm(ens1)%x2c_cc%rattr, 1)
+      npoint = size(atm(ens1)%x2c_cc%rattr, 2)
+      if (nattr > 0 .and. npoint > 0) &
+           address = c_loc(atm(ens1)%x2c_cc%rattr(1,1))
+   case (2)
+      if (.not. associated(atm(ens1)%c2x_cc%rattr)) then
+         status = 4
+         return
+      endif
+      nattr = size(atm(ens1)%c2x_cc%rattr, 1)
+      npoint = size(atm(ens1)%c2x_cc%rattr, 2)
+      if (nattr > 0 .and. npoint > 0) &
+           address = c_loc(atm(ens1)%c2x_cc%rattr(1,1))
+   case default
+      status = 1
+   end select
+ end subroutine cesm_exchange_buffer_query
