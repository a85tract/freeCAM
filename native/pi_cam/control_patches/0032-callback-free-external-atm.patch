  !================================================================================
 
+  subroutine atm_run_external_iteration_mct(EClock, cdata_a, x2a_a, a2x_a, &
+      loop_complete, status)
+
+    ! FreeCAM has already executed one atmospheric numerical timestep and
+    ! written a2x_a.  Reproduce only the control state at the original
+    ! do-while boundary: advance the private CAM clock once, decide whether
+    ! this ATM component call needs another internal timestep, and run the
+    ! non-numerical end lifecycle only when the loop is complete.  No CAM
+    ! physics, dynamics, import, export, or shadow atmosphere is executed.
+    type(ESMF_Clock), intent(inout) :: EClock
+    type(seq_cdata) , intent(inout) :: cdata_a
+    type(mct_aVect) , intent(inout) :: x2a_a
+    type(mct_aVect) , intent(inout) :: a2x_a
+    logical         , intent(out)   :: loop_complete
+    integer         , intent(out)   :: status
+    integer :: day, mon, tod, yr, ymd
+
+    status = 0
+    loop_complete = .false.
+    if (.not. pycam_run_active) then
+       status = 3
+       return
+    endif
+    if (pycam_expected_action /= 202) then
+       status = 4
+       return
+    endif
+
+    ! In the original atm_run_mct loop, dosend is sampled before the numerical
+    ! timestep, advance_timestep is called once, and a false dosend causes the
+    ! loop to continue without returning to the coupler.  Preserve precisely
+    ! that state transition while Python owns the numerical timestep.
+    loop_complete = pycam_dosend
+    call advance_timestep()
+    if (.not. loop_complete) then
+       ! dosend for the next internal iteration is evaluated at the new CAM
+       ! current time, not at the offset time used by atm_run_end_mct.
+       call get_curr_date(yr, mon, day, tod)
+       ymd = yr*10000 + mon*100 + day
+       pycam_dosend = seq_timemgr_EClockDateInSync(EClock, ymd, tod)
+       pycam_rstwr = pycam_rstwr_sync .and. pycam_dosend
+       pycam_nlend = pycam_nlend_sync .and. pycam_dosend
+       pycam_expected_action = 202
+       return
+    endif
+    pycam_expected_action = 208
+    call atm_run_end_mct(EClock, cdata_a, x2a_a, a2x_a, status)
+ end subroutine atm_run_external_iteration_mct
+
+ !================================================================================
+
