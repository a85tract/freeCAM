+ subroutine atm_run_physics_action_mct(action_id, EClock, cdata_a, x2a_a, &
+      a2x_a, loop_complete, status)
+
+    integer         , intent(in)    :: action_id
+    type(ESMF_Clock), intent(inout) :: EClock
+    type(seq_cdata) , intent(inout) :: cdata_a
+    type(mct_aVect) , intent(inout) :: x2a_a
+    type(mct_aVect) , intent(inout) :: a2x_a
+    logical         , intent(out)   :: loop_complete
+    integer         , intent(out)   :: status
+    integer :: phase_status
+    integer :: yr, mon, day, tod, ymd
+
+    status = 0
+    phase_status = 0
+    loop_complete = .false.
+    if (.not. pycam_run_active) then
+       status = 3
+       return
+    endif
+    if (action_id == 401) then
+       if (pycam_expected_action /= 202 .and. &
+           pycam_expected_action /= 400) then
+          status = 4
+          return
+       endif
+    else if (action_id /= pycam_expected_action + 1) then
+       status = 4
+       return
+    endif
+
+    select case (action_id)
+    case (401)
+       if (single_column) call scam_use_iop_srf(cam_in)
+       call t_startf('CAM_run2')
+       call t_barrierf('sync_phys_run2', mpicom)
+       call t_startf('phys_run2')
+       call cam_phys_run2_prepare(cam_in, phase_status)
+    case (402)
+       call cam_phys_run2_schemes(cam_out, cam_in, phase_status)
+    case (403)
+       call cam_phys_run2_finish()
+       call t_stopf('phys_run2')
+    case (404)
+       call cam_run2_dynamics()
+       call t_stopf('CAM_run2')
+    case (405)
+       call t_startf('CAM_run3')
+       call cam_run3_dynamics(cam_out)
+       call t_stopf('CAM_run3')
+    case (406)
+       call t_startf('CAM_run4')
+       call cam_run4_history()
+    case (407)
+       call cam_run4_restart(cam_out, cam_in, pycam_rstwr, &
+            pycam_yr_sync, pycam_mon_sync, pycam_day_sync, pycam_tod_sync)
+    case (408)
+       call cam_run4_finish(pycam_rstwr, pycam_nlend)
+       call t_stopf('CAM_run4')
+    case (409)
+       call t_startf('CAM_adv_timestep')
+       call advance_timestep()
+       call t_stopf('CAM_adv_timestep')
+    case (410)
+       call t_startf('CAM_run1')
+       call cam_run1_dynamics(cam_in, cam_out, phase_status)
+    case (411)
+       call t_barrierf('sync_phys_run1', mpicom)
+       call t_startf('phys_run1')
+       call cam_phys_run1_prepare(cam_in, cam_out, phase_status)
+    case (412)
+       call cam_phys_run1_schemes(cam_in, cam_out, phase_status)
+       call t_stopf('phys_run1')
+       call t_stopf('CAM_run1')
+    case (413)
+       call t_startf('CAM_export')
+       call atm_export(cam_out, a2x_a%rattr)
+       call t_stopf('CAM_export')
+       loop_complete = pycam_dosend
+       if (.not. loop_complete) then
+          call get_curr_date(yr, mon, day, tod)
+          ymd = yr*10000 + mon*100 + day
+          pycam_dosend = seq_timemgr_EClockDateInSync(EClock, ymd, tod)
+          pycam_rstwr = pycam_rstwr_sync .and. pycam_dosend
+          pycam_nlend = pycam_nlend_sync .and. pycam_dosend
+          pycam_expected_action = 400
+          return
+       endif
+    case default
+       status = 1
+       return
+    end select
+
+    if (phase_status /= 0) then
+       status = phase_status
+       return
+    endif
+    pycam_expected_action = action_id
+ end subroutine atm_run_physics_action_mct
