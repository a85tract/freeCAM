+subroutine phys_run1_schemes(phys_state, ztodt, phys_tend, pbuf2d, &
+     cam_in, cam_out, status)
+    use cam_diagnostics, only: diag_physvar_ic
+    use physics_buffer, only: physics_buffer_desc, pbuf_get_chunk
+    use comsrf, only: fsns, fsnt, flns, sgh30, flnt, landm, fsds
+#if (defined BFB_CAM_SCAM_IOP )
+    use cam_history, only: outfld
+#endif
+    real(r8), intent(in) :: ztodt
+    type(physics_state), intent(inout) :: phys_state(begchunk:endchunk)
+    type(physics_tend), intent(inout) :: phys_tend(begchunk:endchunk)
+    type(physics_buffer_desc), pointer :: pbuf2d(:,:)
+    type(cam_in_t) :: cam_in(begchunk:endchunk)
+    type(cam_out_t) :: cam_out(begchunk:endchunk)
+    integer, intent(out) :: status
+    integer :: c
+#if (! defined SPMD)
+    integer :: mpicom = 0
+#endif
+    type(physics_buffer_desc), pointer :: phys_buffer_chunk(:)
+
+    status = 0
+    if (adiabatic .or. ideal_phys .or. &
+        (single_column .and. scm_crm_mode)) then
+       status = 2
+       return
+    endif
+#ifdef TRACER_CHECK
+    call gmean_mass('before tphysbc DRY', phys_state)
+#endif
+#if (defined BFB_CAM_SCAM_IOP )
+    do c=begchunk, endchunk
+       call outfld('Tg', cam_in(c)%ts, pcols, c)
+    end do
+#endif
+    call t_barrierf('sync_bc_physics', mpicom)
+    call t_startf('bc_physics')
+    call t_adj_detailf(+1)
+!$OMP PARALLEL DO PRIVATE (C, phys_buffer_chunk)
+    do c=begchunk, endchunk
+       phys_buffer_chunk => pbuf_get_chunk(pbuf2d, c)
+       call t_startf('diag_physvar_ic')
+       call diag_physvar_ic(c, phys_buffer_chunk, cam_out(c), cam_in(c))
+       call t_stopf('diag_physvar_ic')
+       call tphysbc(ztodt, fsns(1,c), fsnt(1,c), flns(1,c), flnt(1,c), &
+            phys_state(c), phys_tend(c), phys_buffer_chunk, fsds(1,c), &
+            landm(1,c), sgh30(1,c), cam_out(c), cam_in(c))
+    end do
+    call t_adj_detailf(-1)
+    call t_stopf('bc_physics')
+#ifdef TRACER_CHECK
+    call gmean_mass('between DRY', phys_state)
+#endif
+end subroutine phys_run1_schemes
+
+subroutine phys_run2_prepare(phys_state, pbuf2d, cam_in, status)
+    use physics_buffer, only: physics_buffer_desc
+    use mo_lightning, only: lightning_no_prod
+#if ( defined OFFLINE_DYN )
+    use metdata, only: get_met_srf2
+#endif
+    type(physics_state), intent(inout) :: phys_state(begchunk:endchunk)
+    type(physics_buffer_desc), pointer :: pbuf2d(:,:)
+    type(cam_in_t), intent(inout) :: cam_in(begchunk:endchunk)
+    integer, intent(out) :: status
+
+    status = 0
+    if ((single_column .and. scm_crm_mode) .or. adiabatic .or. ideal_phys) then
+       status = 2
+       return
+    endif
+#if ( defined OFFLINE_DYN )
+    call get_met_srf2(cam_in)
+#endif
+    call t_startf('lightning_no_prod')
+    call lightning_no_prod(phys_state, pbuf2d, cam_in)
+    call t_stopf('lightning_no_prod')
+end subroutine phys_run2_prepare
+
+subroutine phys_run2_schemes(phys_state, ztodt, phys_tend, pbuf2d, &
+     cam_out, cam_in, status)
+    use physics_buffer, only: physics_buffer_desc, pbuf_get_chunk
+    use cam_diagnostics, only: diag_surf
+    use comsrf, only: trefmxav, trefmnav, sgh, sgh30, fsds
+    real(r8), intent(in) :: ztodt
+    type(physics_state), intent(inout) :: phys_state(begchunk:endchunk)
+    type(physics_tend), intent(inout) :: phys_tend(begchunk:endchunk)
+    type(physics_buffer_desc), pointer :: pbuf2d(:,:)
+    type(cam_out_t), intent(inout) :: cam_out(begchunk:endchunk)
+    type(cam_in_t), intent(inout) :: cam_in(begchunk:endchunk)
+    integer, intent(out) :: status
+    integer :: c, ncol
+#if (! defined SPMD)
+    integer :: mpicom = 0
+#endif
+    type(physics_buffer_desc), pointer :: phys_buffer_chunk(:)
+
+    status = 0
+    if ((single_column .and. scm_crm_mode) .or. adiabatic .or. ideal_phys) then
+       status = 2
+       return
+    endif
+    call t_barrierf('sync_ac_physics', mpicom)
+    call t_startf('ac_physics')
+    call t_adj_detailf(+1)
+!$OMP PARALLEL DO PRIVATE (C, NCOL, phys_buffer_chunk)
+    do c=begchunk,endchunk
+       ncol = get_ncols_p(c)
+       phys_buffer_chunk => pbuf_get_chunk(pbuf2d, c)
+       call t_startf('diag_surf')
+       call diag_surf(cam_in(c), cam_out(c), phys_state(c)%ps, &
+            trefmxav(1,c), trefmnav(1,c))
+       call t_stopf('diag_surf')
+       call tphysac(ztodt, cam_in(c), sgh(1,c), sgh30(1,c), cam_out(c), &
+            phys_state(c), phys_tend(c), phys_buffer_chunk, fsds(1,c))
+    end do
+    call t_adj_detailf(-1)
+    call t_stopf('ac_physics')
+#ifdef TRACER_CHECK
+    call gmean_mass('after tphysac FV:WET)', phys_state)
+#endif
+end subroutine phys_run2_schemes
+
+subroutine phys_run2_finish(pbuf2d)
