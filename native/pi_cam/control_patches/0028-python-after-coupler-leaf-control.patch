+subroutine tphysac_leaf_action(action_id, ztodt, cam_in, cam_out, state, &
+     tend, pbuf)
+    use physics_buffer, only: physics_buffer_desc
+    use physics_types, only: physics_state, physics_tend, physics_ptend, &
+         physics_update
+    use chemistry, only: chem_is_active, chem_timestep_tend
+    use tracers, only: tracers_timestep_tend
+    use aoa_tracers, only: aoa_tracers_timestep_tend
+    use check_energy, only: check_energy_chng, check_tracers_chng
+    use time_manager, only: get_nstep
+    use aero_model, only: aero_model_drydep
+    use carma_intr, only: carma_timestep_tend
+    use carma_flags_mod, only: carma_do_aerosol
+    use comsrf, only: fsds
+    use water_tracer_vars, only: trace_water
+    use water_tracers, only: wtrc_check_h2o
+    use cam_abortutils, only: endrun
+
+    integer, intent(in) :: action_id
+    real(r8), intent(in) :: ztodt
+    type(cam_in_t), intent(inout) :: cam_in
+    type(cam_out_t), intent(inout) :: cam_out
+    type(physics_state), intent(inout) :: state
+    type(physics_tend), intent(inout) :: tend
+    type(physics_buffer_desc), pointer :: pbuf(:)
+    type(physics_ptend) :: ptend
+    real(r8) :: zero(pcols), fh2o(pcols)
+    integer :: lchnk, nstep
+    logical :: isOK
+
+    lchnk = state%lchnk
+    nstep = get_nstep()
+    zero = 0._r8
+
+    select case (action_id)
+    case (11)
+       call tracers_timestep_tend(state, ptend, cam_in%cflx, &
+            cam_in%landfrac, ztodt)
+       call physics_update(state, ptend, ztodt, tend)
+       call check_tracers_chng(state, pycesm_ac_tracerint(lchnk), &
+            'tracers_timestep_tend', nstep, ztodt, cam_in%cflx)
+    case (12)
+       call aoa_tracers_timestep_tend(state, ptend, cam_in%cflx, &
+            cam_in%landfrac, ztodt)
+       call physics_update(state, ptend, ztodt, tend)
+       call check_tracers_chng(state, pycesm_ac_tracerint(lchnk), &
+            'aoa_tracers_timestep_tend', nstep, ztodt, cam_in%cflx)
+    case (13)
+       if (chem_is_active()) then
+          call chem_timestep_tend(state, ptend, cam_in, cam_out, ztodt, &
+               pbuf, fh2o, fsds(1,lchnk))
+          call physics_update(state, ptend, ztodt, tend)
+          call check_energy_chng(state, tend, 'chem', nstep, ztodt, &
+               fh2o, zero, zero, zero)
+          call check_tracers_chng(state, pycesm_ac_tracerint(lchnk), &
+               'chem_timestep_tend', nstep, ztodt, cam_in%cflx)
+       endif
+       if (trace_water) then
+          isOK = wtrc_check_h2o('after-tracer source/sink', state, &
+               state%q, ztodt)
+       endif
+    case (14)
+       call t_startf('aero_drydep')
+       call aero_model_drydep(state, pbuf, pycesm_ac_obklen(:,lchnk), &
+            pycesm_ac_surfric(:,lchnk), cam_in, ztodt, cam_out, ptend)
+       call physics_update(state, ptend, ztodt, tend)
+       call t_stopf('aero_drydep')
+    case (15)
+       if (carma_do_aerosol) then
+          call t_startf('carma_timestep_tend')
+          call carma_timestep_tend(state, cam_in, cam_out, ptend, ztodt, &
+               pbuf, obklen=pycesm_ac_obklen(:,lchnk), &
+               ustar=pycesm_ac_surfric(:,lchnk))
+          call physics_update(state, ptend, ztodt, tend)
+          call check_energy_chng(state, tend, 'carma_tend', nstep, &
+               ztodt, zero, zero, zero, zero)
+          call t_stopf('carma_timestep_tend')
+       endif
+    case default
+       call endrun('TPHYSAC_LEAF_ACTION: invalid Python action id')
+    end select
+end subroutine tphysac_leaf_action
+
