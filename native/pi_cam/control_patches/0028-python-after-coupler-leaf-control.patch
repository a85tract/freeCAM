+subroutine phys_run2_leaf_action(action_id, phys_state, ztodt, phys_tend, &
+     pbuf2d, cam_out, cam_in, status)
+    use physics_buffer, only: physics_buffer_desc, pbuf_get_chunk, &
+         pbuf_deallocate, pbuf_update_tim_idx
+    use cam_diagnostics, only: diag_deallocate
+    use carma_intr, only: carma_accumulate_stats
+    integer, intent(in) :: action_id
+    real(r8), intent(in) :: ztodt
+    type(physics_state), intent(inout) :: phys_state(begchunk:endchunk)
+    type(physics_tend), intent(inout) :: phys_tend(begchunk:endchunk)
+    type(physics_buffer_desc), pointer :: pbuf2d(:,:)
+    type(cam_out_t), intent(inout) :: cam_out(begchunk:endchunk)
+    type(cam_in_t), intent(inout) :: cam_in(begchunk:endchunk)
+    integer, intent(out) :: status
+    integer :: c
+    integer, save :: expected_leaf_action = 11
+    type(physics_buffer_desc), pointer :: phys_buffer_chunk(:)
+
+    status = 0
+    if ((single_column .and. scm_crm_mode) .or. adiabatic .or. ideal_phys) then
+       status = 2
+       return
+    endif
+    if (action_id < 11 .or. action_id > 19) then
+       status = 1
+       return
+    endif
+    if (action_id /= expected_leaf_action) then
+       status = 4
+       return
+    endif
+    if ((action_id == 11 .and. pycesm_ac_expected_action /= 2) .or. &
+        (action_id == 14 .and. pycesm_ac_expected_action /= 5) .or. &
+        (action_id == 16 .and. pycesm_ac_expected_action /= 1)) then
+       status = 4
+       return
+    endif
+
+    if (action_id == 11) call t_startf('adv_tracer_src_snk')
+    if (action_id <= 15) then
+!$OMP PARALLEL DO PRIVATE (C, phys_buffer_chunk)
+       do c=begchunk,endchunk
+          phys_buffer_chunk => pbuf_get_chunk(pbuf2d, c)
+          call tphysac_leaf_action(action_id, ztodt, cam_in(c), cam_out(c), &
+               phys_state(c), phys_tend(c), phys_buffer_chunk)
+       end do
+    else
+       select case (action_id)
+       case (16)
+          call t_startf('carma_accumulate_stats')
+          call carma_accumulate_stats()
+          call t_stopf('carma_accumulate_stats')
+       case (17)
+          call t_startf('physpkg_st2')
+          call pbuf_deallocate(pbuf2d, 'physpkg')
+       case (18)
+          call pbuf_update_tim_idx()
+       case (19)
+          call diag_deallocate()
+          call t_stopf('physpkg_st2')
+       end select
+    endif
+    if (action_id == 13) call t_stopf('adv_tracer_src_snk')
+
+    select case (action_id)
+    case (13)
+       pycesm_ac_expected_action = 3
+       expected_leaf_action = 14
+    case (15)
+       pycesm_ac_expected_action = 6
+       expected_leaf_action = 16
+    case (19)
+       expected_leaf_action = 11
+    case default
+       expected_leaf_action = action_id + 1
+    end select
+end subroutine phys_run2_leaf_action
+
